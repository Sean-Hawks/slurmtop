def _finish(proc, interrupted):
    """等包起來的指令結束。被中斷時先 terminate，5 秒內不走就 kill；等待中再按一次
    Ctrl-C 也直接 kill，不要留下孤兒行程。"""
    try:
        if interrupted:
            proc.terminate()
            return proc.wait(timeout=5)
        return proc.wait()
    except (subprocess.TimeoutExpired, KeyboardInterrupt):
        proc.kill()
        return proc.wait()


def shell_status(code):
    """Popen 的結束碼轉成 shell 的慣例：被訊號 N 殺掉是 128+N。"""
    if code is None:
        return 0
    return 128 - code if code < 0 else code


def run_report(nodes, opt):
    """--report：取樣一段時間（或跑完一個指令），最後印出摘要。回傳結束碼。"""
    command = list(opt.command or [])
    if command[:1] == ["--"]:                     # 只拿掉開頭那個分隔用的 --，指令自己的參數不動
        command = command[1:]
    command = command or None
    # 輸出檔先確認寫得進去：不要等指令跑起來、甚至整段錄完才發現路徑不對
    try:
        if opt.html:
            open(opt.html, "a", encoding="utf-8").close()
        log = CsvLog(opt.log) if opt.log else None
    except OSError as e:
        sys.exit("slurmtop: %s" % e)
    samples, proc, code, interrupted = [], None, None, False
    if command:
        try:
            proc = subprocess.Popen(command)
        except OSError as e:
            sys.exit("slurmtop: cannot run %s: %s" % (command[0], e))
    end = time.monotonic() + (opt.report or 0)
    try:
        while True:
            t0 = time.monotonic()
            m = model(sample(nodes, opt), opt)
            samples.append(m)
            if log:
                log.write(m)
            if sys.stderr.isatty():               # 導向到檔案時不要塞一堆 \r
                sys.stderr.write("\r" + T("r_progress") % len(samples))
                sys.stderr.flush()
            if proc is not None:
                if proc.poll() is not None:
                    break
            elif time.monotonic() >= end:
                break
            wait = max(0.0, opt.interval - (time.monotonic() - t0))
            if proc is not None:
                try:
                    proc.wait(timeout=wait)
                except subprocess.TimeoutExpired:
                    pass
            else:
                time.sleep(min(wait, max(0.0, end - time.monotonic())))
    except KeyboardInterrupt:                     # Ctrl-C：用已經收集到的資料出報告
        interrupted = True
    finally:
        if log:
            log.close()
    if sys.stderr.isatty():
        sys.stderr.write("\n")
    if proc is not None:
        code = _finish(proc, interrupted)
    if proc is not None and not interrupted or not samples:
        try:                                      # 指令結束後再取一筆，時間算到結束
            samples.append(model(sample(nodes, opt), opt))
        except KeyboardInterrupt:
            pass
    if not samples:
        sys.stderr.write("slurmtop: " + T("r_empty") + "\n")
        return shell_status(code) or 130
    r = summarize(samples, command, code)
    if opt.json:
        print(json.dumps(r, ensure_ascii=_plain, indent=1))
    else:
        print(out_text(report_text(r)))
    if opt.html:
        try:
            with open(opt.html, "w", encoding="utf-8") as f:
                f.write(report_html(r))
            sys.stderr.write(T("r_saved") % opt.html + "\n")
        except OSError as e:                      # 寫不進去也要照指令的結束碼離開
            sys.stderr.write("slurmtop: %s\n" % e)
    return shell_status(code)


def parse_args(argv=None):
    ap = argparse.ArgumentParser(
        description="One-screen dashboard for small GPU clusters (Slurm + nvidia-smi).",
        epilog="credited by team-03/Hawks · https://github.com/Sean-Hawks/slurmtop")
    ap.add_argument("-n", "--interval", type=float, default=2.0,
                    help="refresh interval in seconds (default: 2)")
    ap.add_argument("--once", action="store_true", help="print one frame and exit")
    ap.add_argument("--web", nargs="?", const="127.0.0.1:8765", metavar="[ADDR:]PORT",
                    help="serve a live dashboard in the browser, plus /api/state (JSON) and "
                         "/metrics (Prometheus); default 127.0.0.1:8765 - use ssh -L to view it")
    ap.add_argument("--report", nargs="?", const=0, type=float, metavar="SEC",
                    help="record for SEC seconds - or while running the command given after "
                         "--, e.g. slurmtop --report -- python train.py - then print a summary "
                         "per GPU and node (avg/p95/max, memory, temperature, power, energy)")
    ap.add_argument("--html", metavar="FILE",
                    help="with --report: also write a self-contained HTML report with charts")
    ap.add_argument("--log", metavar="FILE",
                    help="append every sample to a CSV file (live view, --web or --report)")
    ap.add_argument("--json", action="store_true",
                    help="print one sample as JSON and exit (for scripts and other tools)")
    ap.add_argument("--nodes", help="comma-separated node list (default: discover from Slurm)")
    ap.add_argument("--ssh-config", nargs="?", const="~/.ssh/config", metavar="PATH",
                    help="watch every Host in an ssh config file (default path: "
                         "~/.ssh/config; patterns with * ? ! are skipped); "
                         "combines with --nodes")
    ap.add_argument("--title", help="header title (default: Slurm ClusterName)")
    ap.add_argument("--proc", action="store_true", help="list processes on each GPU")
    ap.add_argument("--stack", action="store_true", help="force vertical layout")
    ap.add_argument("--fit", action="store_true",
                    help="squeeze everything into one screen (drops detail if needed)")
    ap.add_argument("--no-color", action="store_true", help="disable colour")
    ap.add_argument("--flair", action="store_true",
                    help="turn on every animation: border traces, scan sweep, breathing and "
                         "blinking, heat plumes, spinning job markers and the boot splash")
    ap.add_argument("--no-splash", action="store_true",
                    help="skip the boot animation (only played with --flair)")
    ap.add_argument("--qr", action="store_true",
                    help="print only the QR code for the project repo and exit")
    ap.add_argument("--qr-wide", action="store_true",
                    help="draw QR modules two characters wide (for fonts where "
                         "half-blocks leave gaps)")
    ap.add_argument("--qr-panel", action="store_true",
                    help="show a QR code for the project repo beside the queue "
                         "(needs a wide terminal)")
    ap.add_argument("--no-qr", action="store_true",
                    help=argparse.SUPPRESS)            # 舊參數：QR 面板已經預設關閉，留著不讓舊指令壞掉
    ap.add_argument("--ascii", action="store_true",
                    help="ASCII bars/sparklines for fonts without block glyphs")
    ap.add_argument("--lang", choices=sorted(STRINGS), help="ui language (default: auto)")
    ap.add_argument("--node-timeout", type=float, default=None, metavar="SEC",
                    help="wait at most this long for each node per refresh; a node that "
                         "misses it keeps its last reading, marked stale (default: %g, "
                         "or %g with --once)" % (NODE_TIMEOUT, ONCE_TIMEOUT))
    ap.add_argument("--dense", action="store_true",
                    help="one summary line per node (automatic when the node panels "
                         "would not fit on the screen)")
    ap.add_argument("--me", action="store_true",
                    help="show only your own jobs and the GPUs they hold")
    ap.add_argument("--idle-samples", type=int, default=IDLE_SAMPLES, metavar="N",
                    help="flag a GPU held by a job whose utilisation stayed below "
                         "%d%%%% for N samples in a row (default: %d)" % (IDLE_UTIL, IDLE_SAMPLES))
    ap.add_argument("-V", "--version", action="version",
                    version=f"slurmtop {__version__} - credited by {__credits__}")
    ap.add_argument("command", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    if args.command and args.report is None:
        ap.error("unexpected arguments: %s (a command is only run with --report)"
                 % " ".join(args.command))
    if args.html and args.report is None:
        ap.error("--html needs --report")
    return args


def pick_nodes(args):
    """--nodes 和 --ssh-config 可以一起用（合併、去重）；兩個都沒給才問 Slurm。"""
    nodes = [n.strip() for n in (args.nodes or "").split(",") if n.strip()]
    if args.ssh_config:
        nodes += [h for h in ssh_config_hosts(args.ssh_config) if h not in nodes]
    if args.nodes or args.ssh_config:
        return nodes
    return discover_nodes()


def want_splash(args):
    return args.flair and not args.no_splash and not _ascii


def options(**kw):
    """預設參數再蓋上 kw，給測試和程式內部直接呼叫 render() 用。"""
    opt = parse_args([])
    for k, v in kw.items():
        setattr(opt, k, v)
    return opt


# 編碼畫不出來時，框線和符號換成的 ASCII
PLAIN = str.maketrans({
    "─": "-", "━": "=", "┈": "-", "│": "|", "╭": "+", "╮": "+", "╰": "+", "╯": "+",
    "┤": "|", "├": "|", "◤": "/", "◥": "\\", "⌜": "+", "⌝": "+", "⌞": "+", "⌟": "+",
    "·": ".", "◉": "o", "●": "*", "◌": ".", "○": "o", "◐": "|", "◓": "/", "◑": "-", "◒": "\\",
    "▲": "^", "▼": "v", "◆": "*", "⚠": "!", "↓": "v", "↑": "^", "…": "...", "°": "",
    "▉": "#", "█": "#", "░": ".", "▕": "[", "▏": "]", "≋": "~", "≈": "~",
    "▁": "_", "▂": "_", "▃": "-", "▄": "-", "▅": "=", "▆": "=", "▇": "#", "▀": "#",
})


def can_draw_blocks(stream=None):
    """輸出的編碼畫不出方塊字（Windows 導向到檔案時的 cp1252、LANG=C 的舊系統…）就改用 ASCII，
    其他畫不出來的字（°、中文）換成 ?，不要整個程式因為 UnicodeEncodeError 掛掉。"""
    stream = stream or sys.stdout
    enc = getattr(stream, "encoding", None) or "ascii"
    try:
        "█▁◉─╭°".encode(enc)
        return True
    except (UnicodeEncodeError, LookupError):
        try:
            stream.reconfigure(errors="replace")
        except Exception:
            pass
        return False


def out_text(s):
    return s.translate(PLAIN) if _plain else s


def enable_windows_ansi():
    """Windows 10 以後的主控台要先開 VT 模式才看得懂 ANSI 色碼。"""
    try:
        import ctypes
        k32 = ctypes.windll.kernel32
        h = k32.GetStdHandle(-11)                   # STD_OUTPUT_HANDLE
        mode = ctypes.c_ulong()
        if k32.GetConsoleMode(h, ctypes.byref(mode)):
            k32.SetConsoleMode(h, mode.value | 0x0004)   # ENABLE_VIRTUAL_TERMINAL_PROCESSING
    except Exception:
        pass


def _exit_on_signal(signum, _frame):
    raise SystemExit(128 + signum)


def main():
    args = parse_args()
    # 子行程開在自己的 session，關掉終端機時不會跟著收到 SIGHUP。收到 TERM/HUP 時
    # 轉成正常結束，finally 會還原終端機、atexit 的 _reap() 會把還在跑的 ssh 砍掉。
    for name in ("SIGTERM", "SIGHUP"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), _exit_on_signal)

    global _color, _lang, _title, _ascii, _flair
    if args.no_color:
        _color = False
    global _plain
    _plain = not can_draw_blocks()
    _ascii = args.ascii or _plain
    if os.name == "nt" and _color:
        enable_windows_ansi()
    _flair = args.flair
    if args.lang:
        _lang = args.lang
    elif any(x in os.environ.get("LANG", "") for x in ("zh_TW", "zh_HK", "zh_CN")):
        _lang = "zh"
    _title = args.title or cluster_name()

    if args.qr:
        show_qr(args.qr_wide)
        return

    nodes = pick_nodes(args)
    if not nodes:
        sys.exit("no nodes found - pass --nodes host1,host2 or --ssh-config")

    if args.web:
        try:
            serve_web(nodes, args)
        except KeyboardInterrupt:
            pass
        return
    if args.report is not None:
        sys.exit(run_report(nodes, args))
    if args.json:                           # 一次取樣、印 JSON 就結束，給腳本和其他工具用
        if args.node_timeout is None:
            args.node_timeout = ONCE_TIMEOUT
        print(json.dumps(model(sample(nodes, args), args), ensure_ascii=False, indent=1))
        return
    if args.once:
        print(out_text(render(nodes, args)))
        return
    try:
        # 1049h = 切到備用畫面緩衝區，25l = 藏游標。
        # 用備用緩衝區而不是狂清畫面，捲動時才不會把舊的畫面留在 scrollback。
        sys.stdout.write("\033[?1049h\033[?25l")
        if want_splash(args):
            splash(nodes)
        log = CsvLog(args.log) if args.log else None
        while True:
            sm = sample(nodes, args)
            if log:
                log.write(model(sm, args))
            sys.stdout.write("\033[H\033[J" + out_text(render(nodes, args, sampled=sm)))
            sys.stdout.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
