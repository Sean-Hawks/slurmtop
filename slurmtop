def arc_gauge(pct):
    """弧形刻度：由左到右代表 0→100%，亮起來的段數就是目前的值。"""
    lit = int(round(max(0.0, min(100.0, pct)) / 100 * len(ARC)))
    cells = []
    for i, h in enumerate(ARC):
        ch = ("#" if _ascii else EIGHTHS[h])
        if i < lit:
            col = heat((i + 1) / len(ARC) * 100)
            if pct >= 90:
                col = pulse(col, 0.3)
            cells.append(rgb(*col, ch))
        else:                                 # 未達到的段落壓平，形狀本身就看得出高低
            cells.append(grey("." if _ascii else "▁"))
    return "".join(cells)


def big(text, color):
    """把字串畫成 5 行高的七段字。核心亮、邊緣暗，做出發光感。"""
    rows = []
    for r in range(5):
        line = ""
        for chx in text:
            glyph = SEG.get(chx, SEG[" "])[r]
            for cell in glyph:
                line += rgb(*color, "█") if cell == "█" else " "
            line += " "
        rows.append(line)
    return rows


# --- 過熱 / 滿載時的反應式動畫 ---
HOT_TEMP = 70          # °C 以上開始冒熱氣
ALERT_TEMP = 78        # °C 以上跳警示
HOT_UTIL = 95          # % 以上算滿載

PLUME = "≋≈~"
PLUME_ASCII = "^~-"


def pulse(color, amount=0.4):
    """讓顏色隨著重畫次數明暗呼吸，用在滿載的東西上。"""
    f = 0.5 + 0.5 * math.cos(_tick * 0.9)
    return tuple(min(255, int(c + (255 - c) * amount * f)) for c in color)


def plume(temp, util):
    """熱氣。溫度高或滿載時在旁邊冒一格，會隨著時間變形。"""
    if temp < HOT_TEMP and util < HOT_UTIL:
        return " "
    chars = PLUME_ASCII if _ascii else PLUME
    ch = chars[(_tick + temp) % len(chars)]      # 加 temp 讓每張卡不同步
    return rgb(*pulse(heat(100 if temp >= ALERT_TEMP else 88), 0.3), ch)


def zone_bg(load):
    """整個節點區塊的底色。負載越高越紅，讓人一眼看出是哪一台在燒。"""
    if _ascii or not _color or load < 45:
        return ""
    if load < 75:
        r, g, b = 26, 20, 6            # 微暖的琥珀
    elif load < 90:
        r, g, b = 40, 18, 6            # 橘
    else:
        r, g, b = 52, 12, 14           # 紅（滿載時再脈動一下）
        f = 0.5 + 0.5 * math.cos(_tick * 0.9)
        r, g, b = int(r + 22 * f), int(g + 4 * f), int(b + 6 * f)
    return f"\033[48;2;{r};{g};{b}m"


def tint(rows, bg):
    """把底色套到整塊區域。行內每個 reset 之後要重新上底色，否則會斷掉。"""
    if not bg:
        return rows
    return [bg + r.replace("\033[0m", "\033[0m" + bg) + "\033[0m" for r in rows]


def blink(text, color, period=2):
    """警示閃爍：一半的時間亮，一半的時間暗。"""
    return rgb(*color, text) if _tick % (period * 2) < period else dim(text)


SPINNER = "◐◓◑◒"
SPINNER_ASCII = "|/-\\"


def spinner():
    chars = SPINNER_ASCII if _ascii else SPINNER
    return chars[_tick % len(chars)]


def trend(key, now):
    """跟最近幾筆比，回傳 ▲ / ▼ / 中性符號。"""
    h = list(_hist[key])[:-1][-4:]
    if len(h) < 2:
        return grey("·")
    avg = sum(h) / len(h)
    if now > avg + 4:
        return rgb(231, 76, 60, "^" if _ascii else "▲")
    if now < avg - 4:
        return rgb(46, 204, 113, "v" if _ascii else "▼")
    return grey("·")


def gpu_strip(gpus, sep=""):
    """每張卡一格燈號，一眼看完整台的分布。"""
    ch = "#" if _ascii else "▉"
    out = []
    for g in gpus:
        u = float(g[1])
        if u < 1:
            out.append(grey("." if _ascii else "▁"))
        elif u >= HOT_UTIL:
            out.append(rgb(*pulse(heat(u), 0.35), ch))
        else:
            out.append(rgb(*heat(u), ch))
    return sep.join(out)


def sh(cmd, timeout=12):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def discover_nodes():
    """Node list from Slurm; falls back to the local host."""
    out = sh('sinfo -h -N -o "%N"').split()
    seen, nodes = set(), []
    for n in out:
        if n not in seen:
            seen.add(n)
            nodes.append(n)
    return nodes or [local_host()]


def node_hostnames():
    """Slurm NodeName -> NodeHostName, so we can tell which node is local."""
    m = {}
    for line in sh('scontrol show node -o').splitlines():
        name = re.search(r"NodeName=(\S+)", line)
        host = re.search(r"NodeHostName=(\S+)", line)
        if name:
            m[name.group(1)] = host.group(1) if host else name.group(1)
    return m


_host = None


def local_host():
    global _host
    if _host is None:
        _host = sh("hostname -s").strip()
    return _host


_hostmap = None


def is_local(node):
    global _hostmap
    if _hostmap is None:
        _hostmap = node_hostnames()
    h = local_host()
    return node == h or _hostmap.get(node, node) == h


REMOTE = f"""
head -1 /proc/stat
echo '@@'
cat /proc/loadavg; nproc
echo '@@'
free -m | awk '/^Mem:/{{print $2, $3}}'
echo '@@'
nvidia-smi --query-gpu={GPU_Q} --format=csv,noheader,nounits
echo '@@'
nvidia-smi --query-compute-apps={PROC_Q} --format=csv,noheader,nounits 2>/dev/null
"""


def run_script(node, script, timeout=20):
    # ControlMaster：第一次連線後重複使用，省掉每次重畫的 SSH 握手
    argv = ["bash", "-s"] if is_local(node) else [
        "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4",
        "-o", "ControlMaster=auto",
        "-o", f"ControlPath=/tmp/.slurmtop-{os.getuid()}-%r@%h:%p",
        "-o", "ControlPersist=120",
        node, "bash", "-s"]
    try:
        r = subprocess.run(argv, input=script, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def snapshot(node):
    parts = [p.strip() for p in run_script(node, REMOTE).split("@@")]
    if len(parts) < 4:            # 節點忙碌時 nvidia-smi 偶爾會慢到超時，重試一次
        parts = [p.strip() for p in run_script(node, REMOTE).split("@@")]
    if len(parts) < 4:
        return None
    d = {}
    # CPU% 用跟上一次重畫的累積值差算，不必在遠端 sleep 取樣
    try:
        cur = list(map(int, parts[0].splitlines()[0].split()[1:]))
        prev = _cpu_prev.get(node)
        _cpu_prev[node] = cur
        if prev and len(prev) == len(cur):
            idle_d = (cur[3] + cur[4]) - (prev[3] + prev[4])
            tot_d = sum(cur) - sum(prev)
            d["cpu_pct"] = max(0.0, min(100.0, 100.0 * (tot_d - idle_d) / tot_d)) if tot_d else 0.0
        else:
            d["cpu_pct"] = 0.0
    except Exception:
        d["cpu_pct"] = 0.0
    try:
        lines = parts[1].splitlines()
        d["load"] = [float(x) for x in lines[0].split()[:3]]
        d["ncpu"] = int(lines[1])
    except Exception:
        d["load"], d["ncpu"] = [0, 0, 0], 0
    try:
        mt, mu = parts[2].split()
        d["mem_total"], d["mem_used"] = int(mt), int(mu)
    except Exception:
        d["mem_total"] = d["mem_used"] = 0
    d["gpus"] = [[x.strip() for x in ln.split(",")] for ln in parts[3].splitlines() if ln.strip()]
    d["procs"] = []
    if len(parts) > 4:
        for ln in parts[4].splitlines():
            f = [x.strip() for x in ln.split(",")]
            if len(f) >= 3:
                d["procs"].append(f)
    return d


def node_panel(node, d, width, show_proc, sparks, compact=False):
    """回傳一台節點的面板行（已含邊框，每行寬度 = width）。"""
    inner = width - 2
    rows = []

    def line(content):
        rows.append(V + pad(clip(content, inner), inner) + V)

    if not d or not d["gpus"]:
        title = f" {bold(node)} "
        rows.append(TL + H * 2 + title + H * max(0, inner - vlen(title) - 2) + TR)
        line("  " + rgb(231, 76, 60, T("unreachable")))
        rows.append(BL + H * inner + BR)
        return rows

    utils = [float(g[1]) for g in d["gpus"]]
    avg_util = sum(utils) / len(utils)
    vram_u = sum(float(g[2]) for g in d["gpus"]) / 1024
    vram_t = sum(float(g[3]) for g in d["gpus"]) / 1024
    power = sum(float(g[5]) for g in d["gpus"])
    busy = sum(1 for u in utils if u > 5)
    tmax = max(int(float(g[4])) for g in d["gpus"])
    mem_pct = d["mem_used"] / d["mem_total"] * 100 if d["mem_total"] else 0

    _hist[(node, "cpu")].append(d["cpu_pct"])
    _hist[(node, "gpu")].append(avg_util)

    # 標題列
    where = T("local") if is_local(node) else T("remote")
    dot = "o" if _ascii else "◉"
    led = (blink(dot, heat(avg_util)) if avg_util >= 90 else rgb(*heat(avg_util), dot))
    left = (f"{dim(cyan('┤'))} {dim('NODE')} {bold(cyan(node))} {led} "
            f"{dim(where.upper())} {dim(cyan('├'))}")
    right = (f" {busy}/{len(d['gpus'])} {T('busy')} {dim('·')} {vram_u:.0f}G {dim('·')} "
             f"{mag('%.1f kW' % (power / 1000))} {dim('·')} {tmax}°C ")
    if vlen(left) + vlen(right) > inner:            # 窄視窗時右側資訊先讓位
        right = clip(right, max(0, inner - vlen(left)))
    fill = max(0, inner - vlen(left) - vlen(right))
    edge = rgb(*heat(avg_util), H * fill)          # 邊框顏色跟著整台負載走
    rows.append(trace(TL + left + edge + right + TR, tick_offset=hash(node) % 7))

    sp = (" " + spark(_hist[(node, "cpu")], 8)) if sparks else ""
    ld = d["load"]
    line(f" {dim(cyan('CPU'))} {gradbar(d['cpu_pct'])} {d['cpu_pct']:5.1f}%"
         f" {trend((node, 'cpu'), d['cpu_pct'])}{sp} "
         f"{dim(f'load {ld[0]:.0f} {ld[1]:.0f} {ld[2]:.0f}')}")
    mem_txt = "%.0f/%.0f GiB" % (d["mem_used"] / 1024, d["mem_total"] / 1024)
    line(f" {dim(cyan('MEM'))} {gradbar(mem_pct)} {mem_pct:5.1f}%   {dim(mem_txt)}")
    for g in d["gpus"]:                      # 歷史一定要更新，即使沒畫出來
        _hist[(node, f"g{g[0]}")].append(float(g[1]))

    if compact:
        line(f" {bold('GPU')} {gradbar(avg_util)} {avg_util:5.1f}% "
             f"{dim('%d/%d %s' % (busy, len(d['gpus']), T('busy')))} "
             f"{dim('%.0f/%.0fG' % (vram_u, vram_t))}")
        rows.append(rgb(*heat(avg_util), BL + H * inner + BR))
        return tint(rows, zone_bg(avg_util))

    for g in d["gpus"]:
        idx, util = g[0], float(g[1])
        mu, mt, temp, pw = float(g[2]), float(g[3]), int(float(g[4])), float(g[5])
        tcol = heat(max(0, min(100, (temp - 35) / 50 * 100)))
        sp = (" " + spark(_hist[(node, f"g{idx}")], 8)) if sparks else ""
        line(f" {dim(cyan('G'))}{bold(idx)} {gradbar(util, 12, util >= HOT_UTIL)} "
             f"{util:3.0f}%{plume(temp, util)}{sp} "
             f"{mu/1024:5.1f}G {rgb(*tcol, f'{temp:>2}°')} {dim(f'{pw:4.0f}W')}")

    if show_proc and d["procs"]:
        for pid, mem, name in d["procs"][:8]:
            line(dim(f"   {pid:>8} {float(mem)/1024:5.1f}G {name.split('/')[-1][:18]}"))
        if len(d["procs"]) > 8:
            line(dim(f"   …還有 {len(d['procs']) - 8} 個"))

    rows.append(rgb(*heat(avg_util), BL + H * inner + BR))
    return tint(rows, zone_bg(avg_util))


EIGHTHS = " ▁▂▃▄▅▆▇█"


def scope(vals, width, height=6):
    """示波器：像心電圖一樣循環掃描，寫入頭在畫面上跑，舊資料留在右邊。

    每格用八分之一方塊做次像素解析度，所以 6 行能表現 48 級。
    """
    v = list(vals)
    slots = [None] * width
    for i, x in enumerate(v):
        slots[i % width] = x
    head = (len(v) - 1) % width if v else -1

    rows = []
    for r in range(height):
        base = (height - 1 - r) * 8            # 這行代表的底部高度（單位：八分之一格）
        line = []
        for i, x in enumerate(slots):
            if x is None:                      # 還沒掃到的區域
                line.append(grey("." if _ascii else "·"))
                continue
            level = max(0.0, min(100.0, x)) / 100 * height * 8
            f = level - base
            if f <= 0:
                ch, col = ("." if _ascii else "·"), None
            elif f >= 8:
                ch, col = ("#" if _ascii else "█"), heat(x)
            else:
                ch, col = ("+" if _ascii else EIGHTHS[int(f)]), heat(x)
            if i == head:                      # 寫入頭：整欄提亮
                line.append(rgb(150, 245, 255, ch if ch != "·" else ("|" if _ascii else "│")))
            elif col is None:
                line.append(grey(ch))
            else:
                line.append(rgb(*col, ch))
        rows.append("".join(line))
    return rows


def trace(border, tick_offset=0):
    """讓一顆亮點沿著邊框跑，像電路上的訊號。"""
    if _ascii or vlen(border) < 8:
        return border
    plain = ANSI.sub("", border)
    idx = 2 + (_tick * 2 + tick_offset) % max(1, len(plain) - 4)
    if plain[idx] not in "─═┈":
        return border

    # 要在「原字串」裡找到第 idx 個可見字元的位置。直接拿 plain 的索引去切
    # 原字串會切進 ANSI 序列中間，把顏色碼截斷成亂碼。
    raw, seen = 0, 0
    while raw < len(border):
        if border[raw] == "\033":
            end = border.find("m", raw)
            if end == -1:
                break
            raw = end + 1
            continue
        if seen == idx:
            return border[:raw] + rgb(120, 240, 255, "━") + border[raw + 1:]
        seen += 1
        raw += 1
    return border


REPO_URL = "https://github.com/Sean-Hawks/slurmtop"


def qr_lines(quiet=4, wide=False):
    """把內嵌的 QR 畫成可掃描的文字。

    預設用半形方塊：一個字元格放上下兩個模組（前景畫上面、背景畫下面），
    模組是 1 格寬 x 半格高。一般終端機的字元格約 1:2，所以模組接近正方形；
    實測長寬比 1.8~2.4 之間都解得出來。這也是 `qrencode -t ANSIUTF8` 的做法。

    wide=True 改成一個模組兩個字元寬、一列高，只用背景色，完全不依賴
    方塊字符的字型覆蓋範圍。寬度變兩倍，給字型會讓 ▀ 留縫的終端機用。
    """
    grid = []
    for r in QR_ROWS:
        bits = bin(int(r, 16))[2:].zfill(QR_SIZE)
        grid.append([0] * quiet + [int(b) for b in bits] + [0] * quiet)
    pad_row = [0] * (QR_SIZE + quiet * 2)
    grid = [list(pad_row) for _ in range(quiet)] + grid + \
           [list(pad_row) for _ in range(quiet)]

    if wide or _ascii:
        if _ascii:
            return ["".join("██" if c else "  " for c in row) for row in grid]
        dark, light = "\033[48;2;0;0;0m  ", "\033[48;2;255;255;255m  "
        return ["".join(dark if c else light for c in row) + "\033[0m"
                for row in grid]

    if len(grid) % 2:                              # 補成偶數列才好兩兩配對
        grid.append(list(pad_row))
    out = []
    for y in range(0, len(grid), 2):
        line = ""
        for x in range(len(grid[0])):
            fg = "0;0;0" if grid[y][x] else "255;255;255"
            bg = "0;0;0" if grid[y + 1][x] else "255;255;255"
            line += f"\033[38;2;{fg}m\033[48;2;{bg}m▀"
        out.append(line + "\033[0m")
    return out


QR_QUIET = 4
QR_W = QR_SIZE + QR_QUIET * 2 + 2         # 半形方塊：一模組一欄 + 兩側外框


def qr_panel(height):
    """右下角的 QR 區塊：外面包一層取景框，白底靜區完整保留才掃得到。"""
    body = qr_lines(QR_QUIET)
    inner = QR_SIZE + QR_QUIET * 2

    head = f"{dim(cyan('┤'))} {bold(cyan('SCAN'))} {dim(cyan('├'))}"
    rows = [head + dim(cyan("─" * max(0, QR_W - vlen(head))))]

    # 取景框：四角用括號，邊線暗青色，都在白色靜區之外，不影響掃描
    rows.append(cyan("⌜") + dim(cyan("─" * inner)) + cyan("⌝"))
    for line in body:
        rows.append(dim(cyan("│")) + line + dim(cyan("│")))
    rows.append(cyan("⌞") + dim(cyan("─" * inner)) + cyan("⌟"))

    url = REPO_URL.split("//", 1)[1]               # 去掉 https:// 才置中得下
    rows.append(pad("", max(0, (QR_W - len(url)) // 2)) + dim(cyan(url)))

    while len(rows) < height:
        rows.append("")
    return rows


def show_qr(wide=False):
    print()
    for line in qr_lines(QR_QUIET, wide):
        print("  " + line)
    print()
    print("  " + bold(cyan(REPO_URL)))
    print("  " + dim(f"slurmtop {__version__} · credited by {__credits__}"))
    print()


def splash(nodes):
    """開機動畫。純裝飾，--no-splash 可關掉。"""
    steps = [
        "probing slurm controller",
        f"discovering nodes ... {len(nodes)} found",
        "opening telemetry links",
        "arming sparkline buffers",
        "link established",
    ]
    W = 62
    for i in range(len(steps) * 3):
        step = steps[min(i // 3, len(steps) - 1)]
        # 每幀讓 logo 的顏色掃過去一次，做出通電感
        t = (i % 6) / 5
        col = tuple(int(86 + (255 - 86) * t * f) for f in (1, 0.5, 0.2))
        col = (min(255, col[0]), min(255, 211 + col[1] // 8), min(255, 240))
        body = big("SLURMTOP", col)
        done = int((i + 1) / (len(steps) * 3) * (W - 2))
        bar = (rgb(86, 211, 240, "█" * done) + grey("░" * (W - 2 - done)))
        frame = ["", *["   " + b for b in body], "",
                 "   " + cyan("[") + bar + cyan("]"),
                 "   " + dim("· " + step + " ..."), ""]
        sys.stdout.write("\033[H\033[J" + "\n".join(frame))
        sys.stdout.flush()
        time.sleep(0.07)


def cluster_header(snaps, width):
    """HUD 主讀數：七段大字 + 遙測列 + 全叢集 GPU 格點圖。"""
    gpus = [g for d in snaps if d for g in d["gpus"]]
    if not gpus:
        return [rgb(231, 76, 60, "NO TELEMETRY")]
    utils = [float(g[1]) for g in gpus]
    avg = sum(utils) / len(utils)
    busy = sum(1 for u in utils if u > 5)
    power = sum(float(g[5]) for g in gpus)
    tmax = max(int(float(g[4])) for g in gpus)
    vram_u = sum(float(g[2]) for g in gpus) / 1024
    vram_t = sum(float(g[3]) for g in gpus) / 1024
    _hist[("all", "gpu")].append(avg)

    # 頂列：◤ SLURMTOP ── cluster ─────────── 時間 ◥
    tag = f" {bold(cyan('SLURMTOP'))} {dim('//')} {bold(_title)} "
    clock = f" {dim(time.strftime('%H:%M:%S'))} "
    fill = max(0, width - vlen(tag) - vlen(clock) - 2)
    out = [cyan("◤") + tag + dim("─" * fill) + clock + cyan("◥")]

    # 左邊弧形儀表，右邊遙測欄
    lab = lambda t: dim(cyan(f"{t:<5}"))
    gauge = [
        "  " + arc_gauge(avg),
        "  " + pad(f"{bold('%.1f%%' % avg)} {dim(cyan('UTIL'))}", 17),
        "  " + pad(f"{trend(('all', 'gpu'), avg)} {spark(_hist[('all', 'gpu')], 12)}", 17),
    ]
    tele = [
        f"{lab('CORE')} {bold(str(busy))}/{len(gpus)} {dim('online')}"
        + (("   " + blink("◆ FULL LOAD", (255, 170, 40))) if avg >= 90 else ""),
        f"{lab('PWR')}  {mag('%.2f kW' % (power / 1000))}   "
        f"{lab('MEM')} {vram_u:.0f}{dim('/')}{vram_t:.0f} GiB   "
        f"{lab('THRM')} {rgb(*heat(max(0, min(100, (tmax - 35) / 50 * 100))), '%d°C' % tmax)}"
        + (("  " + blink("▲ THERMAL", (231, 76, 60))) if tmax >= ALERT_TEMP else ""),
        f"{lab('GRID')} " + ("  " + dim("│") + "  ").join(
            gpu_strip(d["gpus"]) for d in snaps if d and d["gpus"]),
    ]
    for i in range(3):
        out.append(clip(pad(gauge[i], 21) + tele[i], width))
    return out


def progress(elapsed, limit, width=8):
    """job 已用掉多少時間上限。快到上限會轉紅。"""
    e, l = dur_sec(elapsed), dur_sec(limit)
    if not l or e is None:
        return grey(("." if _ascii else "·") * width)
    pct = min(100.0, 100.0 * e / l)
    _, full, empty, _, _ = glyphs()
    filled = int(round(pct / 100 * width))
    col = pulse(heat(pct), 0.3) if pct >= 85 else heat(pct)
    return rgb(*col, full * filled) + grey(empty * (width - filled))


def job_cell(f, narrow, where_w=20):
    """一個 job 的一列字串。narrow 用在多欄排版。"""
    jid, name, st, elapsed, left, nodes, cpus, gres, where = f[:9]
    limit = f[9] if len(f) > 9 else ""
    if st == "R":
        badge = rgb(46, 204, 113, spinner() + " " + T("run"))
    elif st == "PD":
        badge = rgb(241, 196, 15, ("." if _ascii else "◌") + " " + T("pend"))
    else:
        badge = grey(f"o {st}" if _ascii else f"○ {st}")
    gpu = gres.replace("gres:gpu:", "").replace("N/A", "-")
    if narrow:
        return (f" {bold('%7s' % jid[:7])} {name[:9]:<9} {pad(badge, 6)} "
                f"{pad(fmt_dur(elapsed), 7)} {progress(elapsed, limit, 5)} "
                f"{pad(fmt_dur(left), 7)}{gpu:>2} {cyan(where[:where_w])}")
    return (f"  {bold('%7s' % jid[:7])}  {name[:11]:<11} {pad(badge, 7)} "
            f"{pad(fmt_dur(elapsed), 9)} {progress(elapsed, limit)} "
            f"{pad(fmt_dur(left), 9)} "
            f"{nodes:>2} {cpus:>4} {gpu:>4}  {cyan(where[:where_w])}")


def job_header(narrow):
    if narrow:
        return (f" {T('job'):>7} {T('name'):<9} {pad(T('state'), 6)} "
                f"{pad(T('used'), 7)} {pad(T('prog'), 5)} "
                f"{pad(T('left'), 7)}{T('gpu'):>2} {T('where')}")
    return (f"  {T('job'):>7}  {T('name'):<11} {pad(T('state'), 7)} "
            f"{pad(T('used'), 9)} {pad(T('prog'), 8)} {pad(T('left'), 9)} "
            f"{T('nd'):>2} {T('cpu'):>4} {T('gpu'):>4}  {T('where')}")


def slurm_section(width, max_rows=99, job_cols=1, data=None):
    """回傳 (畫面行, 沒顯示到的 job 數)。job_cols>1 時佇列會排成多欄。"""
    inner = width - 2
    rows = []
    title = f"{dim(cyan('┤'))} {bold(T('queue'))} {dim(cyan('├'))}"
    rows.append(trace(TL + title + H * max(0, inner - vlen(title)) + TR, 3))

    def line(c):
        rows.append(V + pad(clip(c, inner), inner) + V)

    hidden = 0
    raw, info = data
    if not raw:
        line(dim("  " + T("no_jobs")))
    else:
        parsed = [ln.split("|") for ln in raw.splitlines()]
        parsed = [f for f in parsed if len(f) >= 10]
        narrow = job_cols > 1
        colw = inner // job_cols

        fixed = 46 if narrow else 75          # WHERE 之前所有欄位的固定寬度
        where_w = max(4, colw - fixed)
        line(dim("".join(pad(clip(job_header(narrow), colw - 1), colw)
                             for _ in range(job_cols))))
        cap = max(job_cols, max_rows * job_cols)
        hidden = max(0, len(parsed) - cap)
        cells = [job_cell(f, narrow, where_w) for f in parsed[:cap]]
        for i in range(0, len(cells), job_cols):
            group = cells[i:i + job_cols]
            line("".join(pad(clip(c, colw - 1), colw) for c in group))
        if hidden:
            line(dim("  " + T("hidden") % hidden))

    if info:
        line(dim(" " + "┈" * (inner - 2)))
        seen = set()
        for ln in info.splitlines():
            n, state, c, m = (ln.split("|") + ["", "", "", ""])[:4]
            if n in seen:      # sinfo -N 每個佇列列一次，同一台只顯示一行
                continue
            seen.add(n)
            alloc, idle, other, total = (c.split("/") + ["0"] * 4)[:4]
            free_mb = (m.split("/") + ["0"])[0]
            free_gib = int(free_mb) / 1024 if free_mb.isdigit() else 0
            pct = 100 * int(alloc) / int(total) if total.isdigit() and int(total) else 0
            line(f"  {bold(n):<10} {state:<8} CPU {gradbar(pct, 10)} {alloc}/{total} "
                 f"{dim(T('idle') + ' ' + idle)}   "
                 f"{dim('RAM ' + T('free') + ' %.0f GiB' % free_gib)}")
    rows.append(BL + H * inner + BR)
    return rows, hidden


def render(nodes, show_proc=False, force_stack=False, fit=False, want_qr=True):
    size = shutil.get_terminal_size((120, 45))
    cols, lines = size.columns, size.lines
    sparks = cols >= 118
    global _tick
    _tick += 1
    with _cf.ThreadPoolExecutor(max_workers=max(2, len(nodes))) as pool:
        snaps = list(pool.map(snapshot, nodes))       # 各節點同時抓，不要排隊等
    with _cf.ThreadPoolExecutor(max_workers=2) as pool:
        q = pool.submit(sh, 'squeue -h -o "%i|%j|%t|%M|%L|%D|%C|%b|%R|%l"')
        i = pool.submit(sh, 'sinfo -h -N -o "%N|%T|%C|%e/%m"')
        slurm_data = (q.result().strip(), i.result().strip())

    if not fit:
        # 預設：每張卡的明細與整個佇列都完整顯示，畫面長一點沒關係。
        # 佇列先用單欄；若這樣塞不進視窗，改多欄試著擠進去，但絕不收合或裁切。
        for jcols in (1, 2, 3):
            if jcols > 1 and cols < 46 * jcols:
                break
            frame, _ = _frame(nodes, snaps, cols, 10 ** 6, show_proc, force_stack,
                              sparks, compact=False, job_cols=jcols,
                              slurm_data=slurm_data, want_qr=want_qr)
            if len(frame) <= lines:
                break
        spare = lines - len(frame) - 1          # 下面還空著就把示波器拉高
        if spare > 0:
            frame, _ = _frame(nodes, snaps, cols, 10 ** 6, show_proc, force_stack,
                              sparks, compact=False, job_cols=jcols,
                              slurm_data=slurm_data, want_qr=want_qr,
                              scope_h=6 + spare)
        return "\n".join(frame)

    # --fit：硬塞進一頁。依序犧牲 sparkline -> 每張卡的明細 -> 佇列改多欄 -> 裁 job。
    plans = [(sparks, False, 1), (False, False, 1), (False, True, 1),
             (False, True, 2), (False, True, 3)]
    for sp, compact, jcols in plans:
        if jcols > 1 and cols < 46 * jcols:
            continue
        frame, hidden = _frame(nodes, snaps, cols, lines, show_proc, force_stack,
                               sp, compact, jcols, slurm_data=slurm_data,
                               want_qr=want_qr and not compact)
        if len(frame) <= lines and not hidden:
            break
    return "\n".join(frame[:lines])


def scope_section(width, height=6):
    """全叢集負載示波器。"""
    inner = width - 2
    n = len(_hist[("all", "gpu")])
    title = (f"{dim(cyan('┤'))} {bold('LOAD')} {dim('//')} "
             f"{dim('last %d samples' % min(n, inner - 2))} {dim(cyan('├'))}")
    rows = [trace(TL + title + H * max(0, inner - vlen(title)) + TR)]
    for line in scope(_hist[("all", "gpu")], inner - 2, height):
        rows.append(V + " " + pad(line, inner - 2) + " " + V)
    rows.append(BL + H * inner + BR)
    return rows


MIN_PANEL_W = 49          # 一個節點面板至少要這麼寬才擺得下


def _frame(nodes, snaps, cols, lines, show_proc, force_stack, sparks, compact,
           job_cols=1, slurm_data=("", ""), want_qr=True, scope_h=6):
    # 版面填滿整個終端機：先決定一排放幾個面板，再把寬度平均分掉，
    # 而不是用固定寬度、右邊留一大塊空白。
    total_w = max(MIN_PANEL_W, cols - 1)
    percol = 1 if force_stack else max(1, min(len(nodes), total_w // MIN_PANEL_W))
    panel_w = total_w // percol
    total_w = panel_w * percol            # 對齊，避免右邊差一兩格
    sparks = sparks and panel_w >= 58

    panels = [node_panel(n, d, panel_w, show_proc, sparks, compact)
              for n, d in zip(nodes, snaps)]

    out = cluster_header(snaps, total_w)
    if not compact:
        out += scope_section(total_w, scope_h)
    for start in range(0, len(panels), percol):
        group = panels[start:start + percol]
        h = max(len(p) for p in group)
        for i in range(h):
            out.append("".join(pad(p[i] if i < len(p) else "", panel_w) for p in group).rstrip())

    # 剩下的高度留給佇列：總高 - 已用 - Slurm 區塊固定開銷(6) - 頁尾(1) - 保險(1)
    budget = lines - len(out) - 8
    show_qr_panel = want_qr and not _ascii and cols >= total_w and total_w - QR_W >= 72
    qw = QR_W + 2 if show_qr_panel else 0
    if show_qr_panel:
        # QR 區塊固定 20 行高，佇列比它矮的話排多欄一行都省不到，
        # 只會把欄位截斷。這種情況一律用單欄，看得清楚。
        one, hidden_one = slurm_section(total_w - qw, max_rows=max(1, budget),
                                        job_cols=1, data=slurm_data)
        if len(one) <= len(qr_panel(0)) or job_cols == 1:
            sec, hidden = one, hidden_one
        else:
            sec, hidden = slurm_section(total_w - qw, max_rows=max(1, budget),
                                        job_cols=job_cols, data=slurm_data)
    else:
        sec, hidden = slurm_section(total_w - qw, max_rows=max(1, budget),
                                    job_cols=job_cols, data=slurm_data)
    if show_qr_panel:
        qr = qr_panel(len(sec))
        # QR 比佇列高的話，把佇列的框往下拉齊，不要在左邊留一塊空洞
        if len(qr) > len(sec):
            filler = V + " " * (total_w - qw - 2) + V
            sec = sec[:-1] + [filler] * (len(qr) - len(sec)) + [sec[-1]]
        for i in range(max(len(sec), len(qr))):
            left = sec[i] if i < len(sec) else ""
            right = qr[i] if i < len(qr) else ""
            out.append(pad(left, total_w - qw) + "  " + right)
    else:
        out += sec
    footer = "  " + T("footer")
    sign = dim(f"team-03/Hawks · v{__version__}")
    if vlen(footer) + vlen(sign) + 2 <= total_w:          # 擠不下就只留署名
        out.append(pad(dim(footer), total_w - vlen(sign)) + sign)
    else:
        out.append(pad("", max(0, total_w - vlen(sign))) + sign)
    return out, hidden


def cluster_name():
    for line in sh("scontrol show config").splitlines():
        if line.startswith("ClusterName"):
            v = line.split("=", 1)[1].strip()
            if v and v != "(null)":
                return v
    return "cluster"


def main():
    ap = argparse.ArgumentParser(
        description="One-screen dashboard for small GPU clusters (Slurm + nvidia-smi).",
        epilog="credited by team-03/Hawks · https://github.com/Sean-Hawks/slurmtop")
    ap.add_argument("-n", "--interval", type=float, default=2.0,
                    help="refresh interval in seconds (default: 2)")
    ap.add_argument("--once", action="store_true", help="print one frame and exit")
    ap.add_argument("--nodes", help="comma-separated node list (default: discover from Slurm)")
    ap.add_argument("--title", help="header title (default: Slurm ClusterName)")
    ap.add_argument("--proc", action="store_true", help="list processes on each GPU")
    ap.add_argument("--stack", action="store_true", help="force vertical layout")
    ap.add_argument("--fit", action="store_true",
                    help="squeeze everything into one screen (drops detail if needed)")
    ap.add_argument("--no-color", action="store_true", help="disable colour")
    ap.add_argument("--no-splash", action="store_true", help="skip the boot animation")
    ap.add_argument("--qr", action="store_true",
                    help="print only the QR code for the project repo and exit")
    ap.add_argument("--qr-wide", action="store_true",
                    help="draw QR modules two characters wide (for fonts where "
                         "half-blocks leave gaps)")
    ap.add_argument("--no-qr", action="store_true",
                    help="hide the QR panel (shown when the terminal is wide enough)")
    ap.add_argument("--ascii", action="store_true",
                    help="ASCII bars/sparklines for fonts without block glyphs")
    ap.add_argument("--lang", choices=sorted(STRINGS), help="ui language (default: auto)")
    ap.add_argument("-V", "--version", action="version",
                    version=f"slurmtop {__version__} - credited by {__credits__}")
    args = ap.parse_args()

    global _color, _lang, _title, _ascii
    if args.no_color:
        _color = False
    _ascii = args.ascii
    if args.lang:
        _lang = args.lang
    elif any(x in os.environ.get("LANG", "") for x in ("zh_TW", "zh_HK", "zh_CN")):
        _lang = "zh"
    _title = args.title or cluster_name()

    if args.qr:
        show_qr(args.qr_wide)
        return

    nodes = [n.strip() for n in args.nodes.split(",") if n.strip()] if args.nodes \
        else discover_nodes()
    if not nodes:
        sys.exit("no nodes found - pass --nodes host1,host2")

    if args.once:
        print(render(nodes, args.proc, args.stack, args.fit, not args.no_qr))
        return
    try:
        # 1049h = 切到備用畫面緩衝區，25l = 藏游標。
        # 用備用緩衝區而不是狂清畫面，捲動時才不會把舊的畫面留在 scrollback。
        sys.stdout.write("\033[?1049h\033[?25l")
        if not args.no_splash and not _ascii:
            splash(nodes)
        while True:
            sys.stdout.write("\033[H\033[J"
                             + render(nodes, args.proc, args.stack, args.fit,
                                      not args.no_qr))
            sys.stdout.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
