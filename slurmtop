def arc_gauge(pct):
    """弧形刻度：由左到右代表 0→100%，亮起來的段數就是目前的值。"""
    lit = int(round(max(0.0, min(100.0, pct)) / 100 * len(ARC)))
    cells = []
    for i, h in enumerate(ARC):
        ch = ("#" if _ascii else EIGHTHS[h])
        if i < lit:
            col = heat((i + 1) / len(ARC) * 100)
            if pct >= 90:
                col = pulse(col, 0.3)
            cells.append(rgb(*col, ch))
        else:                                 # 未達到的段落壓平，形狀本身就看得出高低
            cells.append(grey("." if _ascii else "▁"))
    return "".join(cells)


def big(text, color):
    """把字串畫成 5 行高的七段字。核心亮、邊緣暗，做出發光感。"""
    rows = []
    for r in range(5):
        line = ""
        for chx in text:
            glyph = SEG.get(chx, SEG[" "])[r]
            for cell in glyph:
                line += rgb(*color, "█") if cell == "█" else " "
            line += " "
        rows.append(line)
    return rows


# --- 過熱 / 滿載時的反應式動畫 ---
HOT_TEMP = 70          # °C 以上開始冒熱氣
ALERT_TEMP = 78        # °C 以上跳警示
HOT_UTIL = 95          # % 以上算滿載

PLUME = "≋≈~"
PLUME_ASCII = "^~-"


def pulse(color, amount=0.4):
    """讓顏色隨著重畫次數明暗呼吸，用在滿載的東西上（--flair，否則維持原色）。"""
    if not _flair:
        return tuple(color)
    f = 0.5 + 0.5 * math.cos(_tick * 0.9)
    return tuple(min(255, int(c + (255 - c) * amount * f)) for c in color)


def plume(temp, util):
    """熱氣。溫度高或滿載時在旁邊冒一格，會隨著時間變形（--flair）。"""
    if not _flair or (temp < HOT_TEMP and util < HOT_UTIL):
        return " "
    chars = PLUME_ASCII if _ascii else PLUME
    ch = chars[(_tick + int(temp)) % len(chars)]  # 加 temp 讓每張卡不同步
    return rgb(*pulse(heat(100 if temp >= ALERT_TEMP else 88), 0.3), ch)


def zone_bg(load):
    """整個節點區塊的底色。負載越高越紅，讓人一眼看出是哪一台在燒。"""
    if _ascii or not _color or load < 45:
        return ""
    if load < 75:
        r, g, b = 26, 20, 6            # 微暖的琥珀
    elif load < 90:
        r, g, b = 40, 18, 6            # 橘
    else:
        r, g, b = 52, 12, 14           # 紅（--flair 時滿載再脈動一下）
        if _flair:
            f = 0.5 + 0.5 * math.cos(_tick * 0.9)
            r, g, b = int(r + 22 * f), int(g + 4 * f), int(b + 6 * f)
    return f"\033[48;2;{r};{g};{b}m"


def tint(rows, bg):
    """把底色套到整塊區域。行內每個 reset 之後要重新上底色，否則會斷掉。"""
    if not bg:
        return rows
    return [bg + r.replace("\033[0m", "\033[0m" + bg) + "\033[0m" for r in rows]


def blink(text, color, period=2):
    """警示閃爍：一半的時間亮，一半的時間暗。沒開 --flair 就一直亮著。"""
    if not _flair:
        return rgb(*color, text)
    return rgb(*color, text) if _tick % (period * 2) < period else dim(text)


SPINNER = "◐◓◑◒"
SPINNER_ASCII = "|/-\\"


def spinner():
    """執行中的 job 標記。--flair 時每次刷新轉一格，否則是固定的點。"""
    if not _flair:
        return "*" if _ascii else "●"
    chars = SPINNER_ASCII if _ascii else SPINNER
    return chars[_tick % len(chars)]


def trend(key, now):
    """跟最近幾筆比，回傳 ▲ / ▼ / 中性符號。"""
    h = list(hist(key))[:-1][-4:]
    if len(h) < 2:
        return grey("·")
    avg = sum(h) / len(h)
    if now > avg + 4:
        return rgb(231, 76, 60, "^" if _ascii else "▲")
    if now < avg - 4:
        return rgb(46, 204, 113, "v" if _ascii else "▼")
    return grey("·")


def gpu_strip(gpus, sep=""):
    """每張卡一格燈號，一眼看完整台的分布。"""
    ch = "#" if _ascii else "▉"
    out = []
    for g in gpus:
        u = g["util"]
        if u is None:                          # 讀不到（MIG 等）
            out.append(grey("-"))
        elif u < 1:
            out.append(grey("." if _ascii else "▁"))
        elif u >= HOT_UTIL:
            out.append(rgb(*pulse(heat(u), 0.35), ch))
        else:
            out.append(rgb(*heat(u), ch))
    return sep.join(out)


def _fx():
    """測試用假資料目錄（SLURMTOP_FIXTURES）。每次呼叫都重讀，測試才能在匯入後再設定。"""
    return os.environ.get("SLURMTOP_FIXTURES") or None


def _fixture(name):
    """讀假資料目錄裡的檔案；沒有這個檔就當作指令不存在，回傳空字串。"""
    try:
        with open(os.path.join(_fx(), name), encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


_procs = set()                   # 還在跑的子行程，程式結束時一併砍掉
_procs_lock = threading.Lock()


def _run(argv, stdin=None, timeout=20, shell=False, strict=False):
    """跑子行程回傳 stdout，逾時或失敗回傳空字串（strict 時回傳 None，結束碼非 0 也算失敗）。

    子行程開在自己的 process group，逾時或程式結束時整組砍掉（bash -s 底下的
    nvidia-smi 也一起），--once 印完畫面就能走，不必等卡住的 ssh。
    """
    try:
        p = subprocess.Popen(argv, shell=shell, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, start_new_session=True)
    except Exception:
        return None if strict else ""
    with _procs_lock:
        _procs.add(p)
    try:
        out, _ = p.communicate(stdin, timeout=timeout)
        return None if strict and p.returncode != 0 else out
    except Exception:
        _kill(p)
        try:
            p.communicate(timeout=2)           # 收屍、關掉管線
        except Exception:
            pass
        return None if strict else ""
    finally:
        with _procs_lock:
            _procs.discard(p)


def _kill(p):
    try:
        os.killpg(p.pid, 9)
    except Exception:
        try:
            p.kill()
        except Exception:
            pass


@atexit.register
def _reap():
    with _procs_lock:
        for p in list(_procs):
            _kill(p)


def sh(cmd, timeout=12, key=None, strict=False):
    """跑一個 shell 指令回傳 stdout。strict 時失敗（逾時、結束碼非 0）回傳 None 而不是空字串。

    假資料模式：不執行指令，改讀 <目錄>/<key>.txt（key 預設是指令的第一個字）；
    有 <key>.fail 這個檔就當作指令失敗。
    """
    if _fx():
        key = key or cmd.split()[0]
        # strict：有 <key>.fail，或根本沒有這個檔（= 這台沒裝這個指令）都算失敗
        if strict and (os.path.exists(os.path.join(_fx(), key + ".fail"))
                       or not os.path.exists(os.path.join(_fx(), key + ".txt"))):
            return None
        return _fixture(key + ".txt")
    return _run(cmd, timeout=timeout, shell=True, strict=strict)


def discover_nodes():
    """Node list from Slurm; falls back to the local host."""
    out = sh('sinfo -h -N -o "%N"', key="sinfo_nodes").split()
    seen, nodes = set(), []
    for n in out:
        if n not in seen:
            seen.add(n)
            nodes.append(n)
    return nodes or [local_host()]


def ssh_config_hosts(path="~/.ssh/config"):
    """~/.ssh/config 裡的 Host 名稱，照出現順序、不重複。

    含萬用字元（* ? ）或否定（!）的是規則不是機器，略過；Match 區塊也略過。
    Include 不展開（通常是別的工具塞的設定），要監看的機器請寫在主設定檔。
    """
    try:
        with open(os.path.expanduser(path), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return []
    hosts = []
    for ln in text.splitlines():
        m = re.match(r"^\s*host\s*(?:=|\s)\s*(.+?)\s*$", ln.split("#", 1)[0], re.I)
        if not m:
            continue
        for h in m.group(1).split():
            h = h.strip('"')
            if h and not re.search(r"[*?!]", h) and h not in hosts:
                hosts.append(h)
    return hosts


def node_hostnames():
    """Slurm NodeName -> NodeHostName, so we can tell which node is local."""
    m = {}
    for line in sh('scontrol show node -o', key="scontrol_nodes").splitlines():
        name = re.search(r"NodeName=(\S+)", line)
        host = re.search(r"NodeHostName=(\S+)", line)
        if name:
            m[name.group(1)] = host.group(1) if host else name.group(1)
    return m


_host = None


def local_host():
    global _host
    if _host is None:
        # Windows 的 hostname 不認得 -s（還會當成要改主機名稱），直接問 Python
        _host = "" if os.name == "nt" else sh("hostname -s").strip()
        _host = _host or socket.gethostname().split(".")[0]
    return _host


_hostmap = None


def is_local(node):
    if node in ("localhost", "127.0.0.1", "::1"):   # 單機模式，別繞 SSH
        return True
    global _hostmap
    if _hostmap is None:
        _hostmap = node_hostnames()
    h = local_host()
    return node == h or _hostmap.get(node, node) == h


# 遠端只跑 POSIX shell 能做的事，並依作業系統分支。輸出分成幾段，每段以
# 「@@段名」開頭，讓解析端不必知道對方是什麼系統，之後加段也不會錯位。
# 沒有 GPU 的機器 gpu、proc 兩段就是空的。
REMOTE = f"""
echo '@@cpu'
if [ -r /proc/stat ]; then
  head -1 /proc/stat
elif sysctl -n kern.cp_time >/dev/null 2>&1; then
  # FreeBSD：累計的 user nice sys intr idle，跟 /proc/stat 一樣由兩次取樣相減
  echo "CPUTIME $(sysctl -n kern.cp_time)"
else
  idle=$(top -l 1 -n 0 2>/dev/null | sed -n 's/^CPU usage:.*, \\([0-9.]*\\)% idle.*/\\1/p')
  echo "PCT $(awk -v i="${{idle:-100}}" 'BEGIN{{printf "%.1f", 100 - i}}')"
fi
echo '@@load'
if [ -r /proc/loadavg ]; then
  cut -d' ' -f1-3 /proc/loadavg
  nproc
else
  sysctl -n vm.loadavg 2>/dev/null | tr -d '{{}}'
  sysctl -n hw.ncpu 2>/dev/null || echo 0
fi
echo '@@mem'
if command -v free >/dev/null 2>&1; then
  free -m | awk '/^Mem:/{{print $2, $3}}'
elif command -v vm_stat >/dev/null 2>&1; then
  tot=$(( $(sysctl -n hw.memsize) / 1048576 ))
  vm_stat | awk -v ps="$(sysctl -n hw.pagesize)" -v tot="$tot" '
    /Pages free/ {{f=$3}} /Pages inactive/ {{i=$3}} /Pages speculative/ {{s=$3}}
    END {{gsub(/\\./,"",f); gsub(/\\./,"",i); gsub(/\\./,"",s)
         printf "%d %d\\n", tot, tot - (f+i+s)*ps/1048576}}'
elif sysctl -n vm.stats.vm.v_free_count >/dev/null 2>&1; then
  # FreeBSD：沒有 free / vm_stat，用頁數算；inactive 跟 free 一樣算可用
  ps=$(sysctl -n hw.pagesize)
  tot=$(( $(sysctl -n hw.physmem) / 1048576 ))
  avail=$(( ($(sysctl -n vm.stats.vm.v_free_count) + $(sysctl -n vm.stats.vm.v_inactive_count)) * ps / 1048576 ))
  echo "$tot $((tot - avail))"
else
  echo "0 0"
fi
echo '@@gpu'
command -v nvidia-smi >/dev/null 2>&1 && \
  nvidia-smi --query-gpu={GPU_Q} --format=csv,noheader,nounits 2>/dev/null
echo '@@proc'
apps=$(command -v nvidia-smi >/dev/null 2>&1 && \
  nvidia-smi --query-compute-apps={PROC_Q} --format=csv,noheader,nounits 2>/dev/null)
[ -n "$apps" ] && echo "$apps"
echo '@@jobs'
# 每個 GPU 行程屬於哪個 Slurm job、哪個使用者：cgroup 路徑裡有 job_<id>
# （v1 是 /slurm/uid_N/job_N/...，v2 是 .../job_N/step_N/...）。不是 Slurm 起的行程印 "-"。
echo "$apps" | cut -d, -f2 | tr -d ' ' | sort -u | while read -r pid; do
  [ -n "$pid" ] && [ -r "/proc/$pid/cgroup" ] || continue
  job=$(grep -o 'job_[0-9]*' "/proc/$pid/cgroup" 2>/dev/null | head -n 1)
  job=${{job#job_}}
  user=$(stat -c %U "/proc/$pid" 2>/dev/null || ps -o user= -p "$pid" 2>/dev/null)
  echo "$pid ${{job:--}} ${{user:--}}"
done
echo '@@amdgpu'
# Linux 上 AMD 的卡（amdgpu 驅動）直接讀 sysfs，不用裝 rocm-smi。每張卡一行原始值：
# 卡名 使用率% VRAM已用(bytes) VRAM總量(bytes) 溫度(毫°C) 功耗(微瓦) unique_id，讀不到的是 "-"
rd() {{ v=$(cat "$1" 2>/dev/null); echo "${{v:--}}"; }}          # 讀不到或空檔都印 "-"
for d in /sys/class/drm/card[0-9]*/device; do
  case "$d" in */card*-*/device) continue ;; esac          # card0-DP-1 這類是接頭，不是卡
  [ -r "$d/gpu_busy_percent" ] && [ "$(rd "$d/vendor")" = "0x1002" ] || continue
  hw=$(ls -d "$d"/hwmon/hwmon* 2>/dev/null | head -n 1)
  pw=$(rd "$hw/power1_average"); [ "$pw" = - ] && pw=$(rd "$hw/power1_input")
  echo "$(basename "$(dirname "$d")") $(rd "$d/gpu_busy_percent") $(rd "$d/mem_info_vram_used")" \
       "$(rd "$d/mem_info_vram_total") $(rd "$hw/temp1_input") $pw $(rd "$d/unique_id")"
done
echo '@@jetson'
# NVIDIA Jetson（Nano、TX2、Xavier、Orin）：nvidia-smi 沒有或讀不到東西，GPU 負載在 sysfs 的
# load（0-1000），溫度在 GPU 的 thermal zone（毫°C），記憶體跟 CPU 共用。印「負載 溫度 型號」。
for f in /sys/devices/gpu.0/load /sys/devices/platform/gpu.0/load /sys/devices/*.gv11b/load \
         /sys/devices/*.gp10b/load /sys/devices/platform/*.ga10b/load \
         /sys/devices/platform/bus@0/*.gpu/load; do
  [ -r "$f" ] || continue
  t=-
  for z in /sys/class/thermal/thermal_zone*; do
    case "$(rd "$z/type")" in GPU-therm|gpu-thermal|GPU-thermal) t=$(rd "$z/temp") ;; esac
  done
  model=$(tr -d '\\000' < /proc/device-tree/model 2>/dev/null | tr ' ' '_')
  echo "$(rd "$f") $t ${{model:--}}"
  break
done
echo '@@applegpu'
# macOS 的 GPU（Apple Silicon、Intel Mac 的內顯／獨顯）：ioreg 不用 sudo 就讀得到使用率。
# 每個加速器一段，以 "+-o" 開頭；解析在 parse_ioreg()。
command -v ioreg >/dev/null 2>&1 && \
  ioreg -r -d 1 -w 0 -c IOAccelerator 2>/dev/null | \
  grep -E '^\\+-o|"(model|PerformanceStatistics|gpu-core-count)"'
echo '@@disk'
# 根目錄的 KiB：總量 已用 可用。macOS 的 / 是唯讀的系統卷（永遠只用了幾 %），
# 使用者的資料在 /System/Volumes/Data，那個才是會滿的。
root=/
[ -d /System/Volumes/Data ] && root=/System/Volumes/Data
df -Pk "$root" 2>/dev/null | awk 'NR==2 {{print $2, $3, $4}}'
echo '@@net'
# 實體網卡累計收／送的 bytes，速度由兩次取樣相減。不算 lo 和容器、VPN 的虛擬網卡，
# 否則同一份流量會經過好幾張卡被重複計算。
if [ -r /proc/net/dev ]; then
  # bond／bridge 的成員（有 master）和 VLAN、IPoIB 子介面（名字有 .）的流量已經算在上層那張卡
  skip=" "
  for m in /sys/class/net/*/master; do
    [ -e "$m" ] && skip="$skip$(basename "$(dirname "$m")") "
  done
  awk -v skip="$skip" 'NR > 2 {{ sub(/^ */, ""); split($0, a, /[: ]+/)
         if (a[1] !~ /^(lo|veth|docker|br-|virbr|cni|flannel|cali|tun|tap)/ && a[1] !~ /\\./ &&
             index(skip, " " a[1] " ") == 0) {{ rx += a[2]; tx += a[10] }} }}
       END {{ printf "%.0f %.0f\\n", rx, tx }}' /proc/net/dev
elif command -v netstat >/dev/null 2>&1; then
  # macOS、FreeBSD：每張卡有一行 <Link#N>。欄位位置看標題列找（FreeBSD 多一欄 Idrop）；
  # 沒有 MAC 位址的卡（utun、lo 之類）那行少一欄，後面的欄位往前移一格。
  netstat -ibn 2>/dev/null | awk '
    NR == 1 {{ for (i = 1; i <= NF; i++) {{ if ($i == "Ibytes") ib = i; if ($i == "Obytes") ob = i }}
               hn = NF; next }}
    ib && $3 ~ /^<Link/ && $1 !~ /^(lo|gif|stf|utun|awdl|llw|bridge|anpi|ap[0-9]|pflog|pfsync|enc|tun|tap)/ {{
      s = (NF < hn) ? 1 : 0; rx += $(ib - s); tx += $(ob - s) }}
    END {{ printf "%.0f %.0f\\n", rx, tx }}'
fi
"""



_fx_calls = defaultdict(int)


def _fixture_node(node, timeout):
    """假資料模式下的 run_script。

    node/<名稱>.txt      REMOTE 的輸出
    node/<名稱>.<k>.txt  第 k 次呼叫的輸出（CPU%、網速這類要兩筆才算得出來的東西）
    node/<名稱>.hang     內容是秒數，模擬卡住的節點：睡到逾時為止，什麼都不回
    """
    _fx_calls[node] += 1
    base = os.path.join("node", node)
    hang = _fixture(base + ".hang").strip()
    if hang:
        time.sleep(min(float(hang), timeout))
        return ""
    return _fixture(f"{base}.{_fx_calls[node]}.txt") or _fixture(base + ".txt")


SHELL_PICK = "command -v bash >/dev/null 2>&1 && exec bash -s || exec sh -s"
HARD_TIMEOUT = 30        # 一次取樣最多跑這麼久就砍掉；畫面不等它，見 fetch()


def run_script(node, script, timeout=HARD_TIMEOUT):
    if _fx():
        return _fixture_node(node, timeout)
    if os.name == "nt" and is_local(node):        # Windows 本機沒有 sh，改用 Python 直接讀
        return local_windows(timeout)
    # REMOTE 只用 POSIX sh 的語法；有 bash 就用 bash，沒有（FreeBSD、精簡的容器）就用 sh。
    # 包在 sh -c 裡，對方的登入 shell 是 csh 或 fish 也照樣能跑。
    if is_local(node):
        return _run(["sh", "-c", SHELL_PICK], stdin=script, timeout=timeout)
    argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4"]
    if hasattr(os, "getuid"):
        # ControlMaster：第一次連線後重複使用，省掉每次重畫的 SSH 握手。
        # Windows 的 OpenSSH 不支援（要 Unix socket），就每次重新連線。
        argv += ["-o", "ControlMaster=auto",
                 "-o", f"ControlPath=/tmp/.slurmtop-{os.getuid()}-%r@%h:%p",
                 "-o", "ControlPersist=120"]
    return _run(argv + [node, "sh -c '%s'" % SHELL_PICK], stdin=script, timeout=timeout)


# --- Windows 本機 ---------------------------------------------------------------
# 沒有 sh、沒有 /proc，用 ctypes 呼叫 Win32 API，組出跟 REMOTE 一樣的段落文字，
# 後面的解析完全共用。遠端節點照樣走 ssh（Windows 10 以後內建 OpenSSH 用戶端）。

def win_sections(cpu, ncpu, mem, gpu="", proc="", disk=None, net=None):
    """把 Windows 讀到的數字排成 REMOTE 的格式。

    cpu = (user, sys, idle) 累計時間；mem = (總量, 已用) bytes；disk = shutil.disk_usage()；
    net = (收, 送) 累計 bytes。沒有 load average，送 0。
    """
    out = ["@@cpu"]
    if cpu:
        out.append("CPUTIME %d 0 %d 0 %d" % cpu)
    out += ["@@load", "0 0 0", str(ncpu or 0), "@@mem"]
    out.append("%d %d" % (mem[0] // 1048576, mem[1] // 1048576) if mem else "0 0")
    out += ["@@gpu", gpu.strip(), "@@proc", proc.strip(), "@@jobs", "@@disk"]
    if disk:
        out.append("%d %d %d" % (disk.total // 1024, disk.used // 1024, disk.free // 1024))
    out.append("@@net")
    if net:
        out.append("%d %d" % net)
    return "\n".join(out) + "\n"


def parse_netstat_e(text):
    """Windows 的 netstat -e：第一個有兩個數字的資料列就是 bytes（標題會翻譯成當地語言，
    例如「位元組」，所以不看文字只看位置）。"""
    for ln in (text or "").splitlines():
        m = re.match(r"^\s*\S.*?\s+(\d+)\s+(\d+)\s*$", ln)
        if m:
            return int(m.group(1)), int(m.group(2))
    return None


def _win_cpu():
    import ctypes
    from ctypes import wintypes
    idle, kern, user = wintypes.FILETIME(), wintypes.FILETIME(), wintypes.FILETIME()
    if not ctypes.windll.kernel32.GetSystemTimes(ctypes.byref(idle), ctypes.byref(kern),
                                                 ctypes.byref(user)):
        return None
    v = lambda ft: (ft.dwHighDateTime << 32) | ft.dwLowDateTime
    return v(user), v(kern) - v(idle), v(idle)     # kernel 時間裡包含 idle，要扣掉


def _win_mem():
    import ctypes

    class MEMORYSTATUSEX(ctypes.Structure):
        _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong)] + \
                   [(n, ctypes.c_ulonglong) for n in (
                       "ullTotalPhys", "ullAvailPhys", "ullTotalPageFile", "ullAvailPageFile",
                       "ullTotalVirtual", "ullAvailVirtual", "ullAvailExtendedVirtual")]
    st = MEMORYSTATUSEX()
    st.dwLength = ctypes.sizeof(st)
    if not ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(st)):
        return None
    return st.ullTotalPhys, st.ullTotalPhys - st.ullAvailPhys


def local_windows(timeout=HARD_TIMEOUT):
    def safe(fn, *a):
        try:
            return fn(*a)
        except Exception:
            return None
    gpu = proc = ""
    smi = shutil.which("nvidia-smi")
    if smi:
        gpu = _run([smi, "--query-gpu=" + GPU_Q, "--format=csv,noheader,nounits"], timeout=timeout)
        proc = _run([smi, "--query-compute-apps=" + PROC_Q, "--format=csv,noheader,nounits"],
                    timeout=timeout)
    drive = os.environ.get("SystemDrive", "C:") + "\\"
    return win_sections(safe(_win_cpu), os.cpu_count(), safe(_win_mem), gpu, proc,
                        safe(shutil.disk_usage, drive),
                        parse_netstat_e(_run(["netstat", "-e"], timeout=timeout)))


NODE_TIMEOUT = 6.0       # 每次刷新最多等每台節點幾秒（--node-timeout）
ONCE_TIMEOUT = 20.0      # --once 只有一次機會，沒有下一次刷新可以補上，等久一點（同 main 以前的值）
STALE_MAX = 60           # 超過這麼久拿不到新資料，就不再沿用舊的，改顯示連不上

_inflight = {}           # key -> (thread, box, 開始時間)：還沒跑完的取樣
_last = {}               # key -> (資料, 取得時間)：最近一次成功的取樣


def _worker(fn, arg, box):
    try:
        box["v"] = fn(arg)
    except Exception:
        box["v"] = None


def fetch(jobs, timeout):
    """同時跑多個取樣，每個最多等到截止時間，回傳 {key: (資料, 過時秒數)}。

    jobs 是 {key: (函式, 參數)}。截止前跑完且有資料的，過時秒數是 None（新鮮）；
    逾時或失敗的沿用上一次成功的資料並回報它舊了幾秒，舊到超過 STALE_MAX 或
    從來沒成功過就是 (None, None)。沒跑完的取樣留著繼續跑，下次刷新直接收
    結果，不會重複再開一個，所以卡住的節點不會越積越多連線。
    """
    for key, (fn, arg) in jobs.items():
        if key not in _inflight:
            box = {}
            t = threading.Thread(target=_worker, args=(fn, arg, box), daemon=True)
            t.start()
            _inflight[key] = (t, box, time.monotonic())
    out = {}
    for key in jobs:
        # 截止時間從這個取樣開始的時候算：前幾次刷新就已經逾時的不再等，
        # 不然一台卡住的節點會讓之後每次刷新都多等 timeout 秒
        t, box, started = _inflight[key]
        t.join(max(0.0, started + timeout - time.monotonic()))
        if not t.is_alive():
            del _inflight[key]
            if box.get("v"):
                _last[key] = (box["v"], _now())
                out[key] = (box["v"], None)
                continue
        last = _last.get(key)
        if last and _now() - last[1] <= STALE_MAX:
            out[key] = (last[0], _now() - last[1])
        else:
            out[key] = (None, None)
    return out


# %A 是真正的 job id：陣列 job 的 %i 會是 123_4，但 cgroup 裡寫的是 %A
SQUEUE = 'squeue -h -o "%i|%j|%t|%M|%L|%D|%C|%b|%R|%l|%u|%A"'
SINFO = 'sinfo -h -N -o "%N|%T|%C|%e/%m"'
# -d 會列出每台節點分到哪幾張卡（GRES=gpu:h200:4(IDX:0-3)），-o 一個 job 一行
SCONTROL_JOBS = "scontrol -d -o show job"


# 控制字元（ESC、BEL、C1…）。job 名稱、使用者、行程名稱是別人可以隨便取的，
# 原樣印到終端機上就能發控制序列：移游標偽造畫面、改視窗標題、OSC 52 寫剪貼簿。
_CTRL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def untrusted(text):
    """從叢集來的文字去掉控制字元，只留換行和 tab。"""
    return _CTRL.sub("", text or "")


def slurm_query(_=None):
    """佇列、節點資源、GPU 分配。squeue 失敗（沒裝 Slurm、控制器沒回應、逾時）回傳 None，
    讓 fetch() 沿用上一次的資料：把失敗當成「沒有 job」會清掉 GPU 的分配紀錄，
    佔著卻閒置的計數也跟著歸零。另外兩個失敗就當作空的。"""
    q = sh(SQUEUE, key="squeue", strict=True)
    if q is None:
        return None
    return (untrusted(q).strip(), untrusted(sh(SINFO, key="sinfo")).strip(),
            untrusted(sh(SCONTROL_JOBS, key="scontrol_jobs")).strip())


def parse_queue(raw):
    """squeue 的輸出切成欄位；欄位不夠的行（格式不對）丟掉。"""
    return [f for f in (ln.split("|") for ln in (raw or "").splitlines()) if len(f) >= 10]


def job_table(queue):
    """真正的 job id -> {id: 顯示用 id, user, name}。"""
    t = {}
    for f in queue:
        raw = f[11] if len(f) > 11 and f[11] else f[0]
        t[raw] = {"id": f[0], "user": f[10] if len(f) > 10 else "", "name": f[1]}
    return t


def expand_hostlist(s):
    """Slurm 的節點清單展開：n[1-3,5],gpu01 -> n1 n2 n3 n5 gpu01（保留前導零）。"""
    parts, depth, cur = [], 0, ""
    for ch in s or "":
        depth += (ch == "[") - (ch == "]")
        if ch == "," and depth == 0:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    out = []
    for p in parts:
        out += _expand_one(p.strip())
    return [x for x in out if x]


def _expand_one(p):
    m = re.match(r"^(.*?)\[([^\]]+)\](.*)$", p)
    if not m:
        return [p]
    pre, body, post = m.groups()
    heads = []
    for r in body.split(","):
        a, _, b = r.partition("-")
        if b and a.isdigit() and b.isdigit():
            heads += [pre + str(i).zfill(len(a)) for i in range(int(a), int(b) + 1)]
        else:
            heads.append(pre + a)
    return [h + t for h in heads for t in _expand_one(post)]


def expand_idx(s):
    """GRES 的 IDX 清單：0-3,5 -> ['0', '1', '2', '3', '5']。"""
    out = []
    for r in (s or "").split(","):
        a, _, b = r.strip().partition("-")
        if a.isdigit() and b.isdigit():
            out += [str(i) for i in range(int(a), int(b) + 1)]
        elif a.isdigit():
            out.append(a)
    return out


def parse_alloc(text):
    """scontrol -d -o show job -> ({(節點, GPU 編號): [job id]}, {job id: 使用者})。

    只看 RUNNING 的 job。每個 job 一行，裡面每組 "Nodes=... GRES=gpu:型號:N(IDX:0-3)"
    是一批節點分到的卡；舊版 Slurm 寫成 GRES_IDX=gpu(IDX:0-3)。這讓「分到卡但卡上
    沒有任何行程」的 job 也找得到，光靠 nvidia-smi 的 pid 看不到這種情況。
    """
    alloc, users = {}, {}
    for ln in (text or "").splitlines():
        jid = re.search(r"\bJobId=(\d+)", ln)
        if not jid or not re.search(r"\bJobState=RUNNING\b", ln):
            continue
        jid = jid.group(1)
        u = re.search(r"\bUserId=([^(\s]+)", ln)
        if u:
            users[jid] = u.group(1)
        # 以每個 " Nodes=" 為界切段，每段找自己的 GRES
        for chunk in re.split(r"(?:^|\s)(?=Nodes=)", ln)[1:]:
            nodes = re.match(r"Nodes=(\S+)", chunk).group(1)
            gres = re.search(r"\bGRES(?:_IDX)?=(\S+)", chunk)
            if not gres:
                continue
            idx = []
            for m in re.finditer(r"gpu[^,(]*\(IDX:([^)]*)\)", gres.group(1)):
                idx += expand_idx(m.group(1))
            for n in expand_hostlist(nodes):
                for i in idx:
                    lst = alloc.setdefault((n, i), [])
                    if jid not in lst:
                        lst.append(jid)
    return alloc, users


SECTIONS = ("cpu", "load", "mem", "gpu", "proc")
GPU_FIELDS = ("idx", "uuid", "util", "mem_used", "mem_total", "temp", "power")  # 順序同 GPU_Q


def num(s):
    """nvidia-smi 的數值欄位轉 float。

    MIG 模式的使用率、某些卡的功耗會是 [N/A]、[Not Supported]、[Unknown Error]，
    也可能整欄是空的。這些一律回傳 None，顯示時畫成 "-"，不要讓整個程式掛掉。
    """
    try:
        v = float((s or "").strip())
    except ValueError:
        return None
    return v if math.isfinite(v) else None


def fnum(v, fmt):
    """依 fmt 格式化數值；讀不到（None）就顯示同寬的 "-"，欄位不會錯位。"""
    return fmt % v if v is not None else "-".rjust(len(fmt % 0))


def parse_gpu(line):
    """--query-gpu 的一行 -> dict。索引以外的欄位讀不到就是 None。"""
    f = [x.strip() for x in line.split(",")]
    # 開頭不是數字的是 nvidia-smi 的訊息（"No devices were found"、驅動連不上……），不是卡
    if not f[0].isdigit():
        return None
    f += [""] * (len(GPU_FIELDS) - len(f))
    g = {"idx": f[0], "uuid": f[1] if f[1] not in ("", "[N/A]") else None}
    for k, v in zip(GPU_FIELDS[2:], f[2:]):
        g[k] = num(v)
    g["jobs"], g["users"] = [], []          # 由 snapshot() 依 cgroup 填上
    return g


def parse_proc(line):
    """--query-compute-apps 的一行 -> dict。行程名稱可能含逗號，所以剩下的全部接回去。"""
    f = [x.strip() for x in line.split(",")]
    if len(f) < 4 or not f[1]:
        return None
    return {"gpu": f[0], "pid": f[1], "mem": num(f[2]), "name": ",".join(f[3:]).strip(),
            "job": None, "user": None}


def parse_pidjobs(text):
    """REMOTE 的 jobs 段：每行 "pid job user"，不是 Slurm 起的行程 job 是 "-"。"""
    out = {}
    for ln in (text or "").splitlines():
        f = ln.split()
        if len(f) >= 3:
            out[f[0]] = (None if f[1] == "-" else f[1], None if f[2] == "-" else f[2])
    return out


def link_procs(gpus, procs, pidjobs):
    """把行程的 job / 使用者掛到它所在的那張卡上（用 GPU UUID 對）。"""
    by_uuid = {g["uuid"]: g for g in gpus if g["uuid"]}
    for p in procs:
        p["job"], p["user"] = pidjobs.get(p["pid"], (None, None))
        g = by_uuid.get(p["gpu"])
        if not g:
            continue
        if p["job"] and p["job"] not in g["jobs"]:
            g["jobs"].append(p["job"])
        if p["user"] and p["user"] not in g["users"]:
            g["users"].append(p["user"])


def gpu_stats(gpus):
    """一群 GPU 的彙總。讀不到的欄位不算進去；整欄都讀不到時平均、功耗、溫度就是 None。"""
    def known(k):
        return [g[k] for g in gpus if g[k] is not None]
    utils, temps, power = known("util"), known("temp"), known("power")
    return {
        "n": len(gpus),
        "util": sum(utils) / len(utils) if utils else None,
        "busy": sum(1 for u in utils if u > 5),
        "vram_u": sum(known("mem_used")) / 1024,
        "vram_t": sum(known("mem_total")) / 1024,
        "power": sum(power) if power else None,
        "tmax": max(temps) if temps else None,
    }


def temp_color(t):
    """溫度的顏色：35°C 綠、85°C 紅。"""
    return heat(max(0, min(100, (t - 35) / 50 * 100)))


def sections(out):
    """把 REMOTE 的輸出依「@@段名」切開，回傳 {段名: 內容}。"""
    secs, cur = {}, None
    for ln in out.splitlines():
        m = re.match(r"^@@(\w+)\s*$", ln)
        if m:
            cur = m.group(1)
            secs[cur] = []
        elif cur:
            secs[cur].append(ln)
    return {k: "\n".join(v).strip() for k, v in secs.items()}


def snapshot(node):
    # 不在這裡重試：慢的節點交給 fetch() 的截止時間處理，畫面先沿用上一筆
    secs = sections(untrusted(run_script(node, REMOTE)))
    if "gpu" not in secs:
        return None
    parts = [secs.get(k, "") for k in SECTIONS]
    d = {}
    # CPU% 用跟上一次重畫的累積值差算，不必在遠端 sleep 取樣
    try:
        first = parts[0].splitlines()[0]
        if first.startswith("PCT"):           # 非 Linux：對方已經算好百分比
            d["cpu_pct"] = max(0.0, min(100.0, float(first.split()[1])))
            raise StopIteration
        cur = list(map(int, first.split()[1:]))
        # /proc/stat 的閒置是 idle + iowait（第 4、5 欄）；FreeBSD／Windows 的 CPUTIME
        # 是 user nice sys intr idle，閒置只有第 5 欄
        idle_at = (4,) if first.startswith("CPUTIME") else (3, 4)
        prev = _cpu_prev.get(node)
        _cpu_prev[node] = cur
        if prev and len(prev) == len(cur):
            idle_d = sum(cur[i] - prev[i] for i in idle_at)
            tot_d = sum(cur) - sum(prev)
            d["cpu_pct"] = max(0.0, min(100.0, 100.0 * (tot_d - idle_d) / tot_d)) if tot_d else 0.0
        else:
            d["cpu_pct"] = 0.0
    except StopIteration:
        pass
    except Exception:
        d.setdefault("cpu_pct", 0.0)
    try:
        lines = parts[1].splitlines()
        d["load"] = [float(x) for x in lines[0].split()[:3]]
        d["ncpu"] = int(lines[1])
    except Exception:
        d["load"], d["ncpu"] = [0, 0, 0], 0
    try:
        mt, mu = parts[2].split()
        d["mem_total"], d["mem_used"] = int(mt), int(mu)
    except Exception:
        d["mem_total"] = d["mem_used"] = 0
    d["gpus"] = [g for g in map(parse_gpu, parts[3].splitlines()) if g]
    d["procs"] = [p for p in map(parse_proc, parts[4].splitlines()) if p]
    link_procs(d["gpus"], d["procs"], parse_pidjobs(secs.get("jobs", "")))
    d["gpus"] += parse_amdgpu(secs.get("amdgpu", ""), len(d["gpus"]))
    if not d["gpus"]:                  # 新版 JetPack 有 nvidia-smi；讀得到就不重複算
        d["gpus"] += parse_jetson(secs.get("jetson", ""), d["mem_total"], d["mem_used"])
    d["gpus"] += parse_ioreg(secs.get("applegpu", ""), d["mem_total"], len(d["gpus"]))
    d["disk"] = parse_disk(secs.get("disk", ""))
    d["net"] = None                              # (收, 送) bytes/s；第一次取樣還算不出來
    cur = parse_net(secs.get("net", ""))
    if cur:
        now = time.monotonic()
        prev = _net_prev.get(node)
        _net_prev[node] = (cur, now)
        if prev:
            d["net"] = net_rate(prev[0], cur, now - prev[1])
    return d


_net_prev = {}                                   # 節點 -> ((收, 送) 累計 bytes, 取樣時間)


def _gpu(idx, vendor, util=None, mem_used=None, mem_total=None, temp=None, power=None,
         model=None, uuid=None):
    """非 NVIDIA 的卡也整理成跟 parse_gpu() 一樣的 dict，後面的程式不必分廠牌。"""
    return {"idx": str(idx), "uuid": uuid, "util": util, "mem_used": mem_used,
            "mem_total": mem_total, "temp": temp, "power": power, "jobs": [], "users": [],
            "vendor": vendor, "model": model}


def parse_amdgpu(text, start=0):
    """REMOTE 的 amdgpu 段 -> GPU 清單。sysfs 的單位：bytes、毫°C、微瓦。

    編號照 card0、card1… 的順序（跟 rocm-smi、Slurm 自動偵測的順序一般相同，
    需在叢集上確認）。同一台同時有 NVIDIA 卡時接在後面編號。
    """
    def val(x, scale=1.0):
        v = num(x)
        return None if v is None else v / scale
    gpus = []
    for ln in (text or "").splitlines():
        f = ln.split()
        if len(f) < 6 or not f[0].startswith("card"):
            continue
        f += ["-"] * (7 - len(f))
        uid = None if f[6] == "-" else "AMD-" + f[6]
        gpus.append(_gpu(start + len(gpus), "amd", val(f[1]), val(f[2], 1048576),
                         val(f[3], 1048576), val(f[4], 1000), val(f[5], 1e6), uuid=uid))
    return gpus


def parse_jetson(text, mem_total_mib=None, mem_used_mib=None):
    """REMOTE 的 jetson 段 -> 一張 GPU。負載 0-1000、溫度毫°C；記憶體是整台共用的 RAM。"""
    f = (text or "").split()
    if len(f) < 2:
        return []
    load_ = num(f[0])
    temp = num(f[1])
    model = f[2].replace("_", " ") if len(f) > 2 and f[2] != "-" else "Jetson"
    return [_gpu(0, "jetson", None if load_ is None else load_ / 10,
                 mem_used_mib or None, mem_total_mib or None,
                 None if temp is None else temp / 1000, None, model)]


def parse_ioreg(text, mem_total_mib=None, start=0):
    """ioreg -c IOAccelerator 的輸出 -> GPU 清單。

    Apple Silicon：使用率是 "Device Utilization %"，記憶體是和 CPU 共用的統一記憶體，
    已用量是 "In use system memory"、總量就是整台的 RAM。溫度和功耗要 sudo powermetrics
    才讀得到，這裡一律 None。Intel Mac 的 AMD 獨顯另有 "GPU Activity(%)"、
    "Temperature(C)"、"Total Power(W)"、vramUsedBytes / vramFreeBytes，有就用。
    """
    blocks = []
    for ln in (text or "").splitlines():
        if ln.startswith("+-o"):
            blocks.append({})
        elif blocks:
            m = re.search(r'"(model|gpu-core-count)"\s*=\s*(?:<?"?)([^">]*)', ln)
            if m:
                blocks[-1][m.group(1)] = m.group(2).strip()
            if '"PerformanceStatistics"' in ln:
                blocks[-1]["stats"] = {k: float(v) for k, v in
                                       re.findall(r'"([^"]+)"=(\d+(?:\.\d+)?)', ln)}
    gpus = []
    for b in blocks:
        st = b.get("stats")
        if st is None:
            continue
        util = st.get("Device Utilization %", st.get("GPU Activity(%)"))
        if "vramUsedBytes" in st:
            used = st["vramUsedBytes"] / 1048576
            total = used + st.get("vramFreeBytes", 0) / 1048576
        else:
            used = st["In use system memory"] / 1048576 if "In use system memory" in st else None
            total = mem_total_mib or None
        model = b.get("model") or None
        if model and b.get("gpu-core-count"):
            model += " %s-core" % b["gpu-core-count"]
        gpus.append(_gpu(start + len(gpus), "apple", util, used, total,
                         st.get("Temperature(C)"), st.get("Total Power(W)"), model))
    return gpus


def parse_disk(text):
    """df -Pk 的「總量 已用 可用」（KiB）-> {total, used, pct}，讀不到回傳 None。"""
    f = [num(x) for x in (text or "").split()[:3]]
    if len(f) < 3 or None in f or f[0] <= 0:
        return None
    total, used, avail = f
    # 跟 df 的 Capacity 一樣用 已用 / (已用 + 可用)，保留給 root 的空間不算
    pct = 100.0 * used / (used + avail) if used + avail > 0 else 0.0
    return {"total": total * 1024, "used": used * 1024, "pct": pct}


def parse_net(text):
    f = [num(x) for x in (text or "").split()[:2]]
    return tuple(f) if len(f) == 2 and None not in f else None


def net_rate(prev, cur, dt):
    """兩次累計值相減算速度。計數器歸零（重開機、網卡重設）或時間不對時回傳 None。"""
    if dt <= 0:
        return None
    rx, tx = (cur[0] - prev[0]) / dt, (cur[1] - prev[1]) / dt
    return (rx, tx) if rx >= 0 and tx >= 0 else None


def fmt_bytes(n, unit=""):
    """1234567 -> '1.2M'。以 1024 為底。"""
    if n is None:
        return "-"
    for u in ("", "K", "M", "G", "T", "P"):
        if abs(n) < 1024 or u == "P":
            return ("%.0f%s%s" if u == "" or abs(n) >= 100 else "%.1f%s%s") % (n, u, unit)
        n /= 1024.0


def node_panel(node, d, width, show_proc, sparks, compact=False, age=None):
    """回傳一台節點的面板行（已含邊框，每行寬度 = width）。age 不是 None 表示資料是舊的。"""
    inner = width - 2
    rows = []

    def line(content):
        rows.append(V + pad(clip(content, inner), inner) + V)

    if not d:
        title = f" {bold(node)} "
        rows.append(TL + H * 2 + title + H * max(0, inner - vlen(title) - 2) + TR)
        line("  " + rgb(231, 76, 60, T("unreachable")))
        rows.append(BL + H * inner + BR)
        return rows

    # 沒有 GPU 的機器（CPU-only 節點、開發用筆電）照樣顯示 CPU/RAM，
    # 整台的「熱度」就改用 CPU 使用率當指標。
    has_gpu = bool(d["gpus"])
    st = gpu_stats(d["gpus"])
    # 全部的卡都讀不到使用率（例如整台開 MIG）時，熱度就當 0，數字顯示 "-"
    avg_util = (st["util"] or 0.0) if has_gpu else d["cpu_pct"]
    busy = st["busy"]
    mem_pct = d["mem_used"] / d["mem_total"] * 100 if d["mem_total"] else 0

    # 標題列
    where = T("local") if is_local(node) else T("remote")
    dot = "o" if _ascii else "◉"
    led = (blink(dot, heat(avg_util)) if avg_util >= 90 else rgb(*heat(avg_util), dot))
    stale = (" " + rgb(241, 196, 15, T("stale") % age)) if age is not None else ""
    left = (f"{dim(cyan('┤'))} {dim('NODE')} {bold(cyan(node))} {led} "
            f"{dim(where.upper())}{stale} {dim(cyan('├'))}")
    if has_gpu:
        pw = fnum(st["power"] / 1000 if st["power"] is not None else None, "%.1f kW")
        right = (f" {busy}/{len(d['gpus'])} {T('busy')} {dim('·')} {st['vram_u']:.0f}G {dim('·')} "
                 f"{mag(pw.strip())} {dim('·')} {fnum(st['tmax'], '%.0f').strip()}°C ")
    else:
        right = f" {d['ncpu']} {T('threads')} {dim('·')} {T('no_gpu')} "
    if vlen(left) + vlen(right) > inner:            # 窄視窗時右側資訊先讓位
        right = clip(right, max(0, inner - vlen(left)))
    fill = max(0, inner - vlen(left) - vlen(right))
    edge = rgb(*heat(avg_util), H * fill)          # 邊框顏色跟著整台負載走
    # 不用 hash()：字串雜湊每次執行都不同，畫面會不可重現
    rows.append(trace(TL + left + edge + right + TR, tick_offset=sum(map(ord, node)) % 7))

    sp = (" " + spark(hist((node, "cpu")), 8)) if sparks else ""
    ld = d["load"]
    line(f" {dim(cyan('CPU'))} {gradbar(d['cpu_pct'])} {d['cpu_pct']:5.1f}%"
         f" {trend((node, 'cpu'), d['cpu_pct'])}{sp} "
         f"{dim(f'load {ld[0]:.0f} {ld[1]:.0f} {ld[2]:.0f}')}")
    mem_txt = "%.0f/%.0f GiB" % (d["mem_used"] / 1024, d["mem_total"] / 1024)
    line(f" {dim(cyan('MEM'))} {gradbar(mem_pct)} {mem_pct:5.1f}%   {dim(mem_txt)}")
    io = disk_net(d, inner)
    if io and not compact:
        line(io)

    if compact:
        line(f" {bold('GPU')} {gradbar(avg_util)} {fnum(st['util'], '%5.1f%%')} "
             f"{dim('%d/%d %s' % (busy, len(d['gpus']), T('busy')))} "
             f"{dim('%.0f/%.0fG' % (st['vram_u'], st['vram_t']))}")
        rows.append(rgb(*heat(avg_util), BL + H * inner + BR))
        return tint(rows, zone_bg(avg_util))

    for g in d["gpus"]:
        idx, util, temp = g["idx"], g["util"], g["temp"]
        u = util or 0.0                                 # 畫長條用；數字照實顯示 "-"
        mu = g["mem_used"] / 1024 if g["mem_used"] is not None else None
        temp_s = fnum(temp, "%2.0f°")
        sp = (" " + spark(hist((node, f"g{idx}")), 8)) if sparks else ""
        line(f" {dim(cyan('G'))}{bold(idx)} {gradbar(u, 12, u >= HOT_UTIL)} "
             f"{fnum(util, '%3.0f%%')}{plume(temp or 0, u)}{sp} "
             f"{fnum(mu, '%5.1fG')} {rgb(*temp_color(temp), temp_s) if temp is not None else grey(temp_s)} "
             f"{dim(fnum(g['power'], '%4.0fW'))}{owner_tag(node, g)}")

    if show_proc and d["procs"]:
        for p in d["procs"][:8]:
            mem = p["mem"] / 1024 if p["mem"] is not None else None
            line(dim(f"   {p['pid']:>8} {fnum(mem, '%5.1fG')} {p['name'].split('/')[-1][:18]}"))
        if len(d["procs"]) > 8:
            line(dim("   " + T("more_procs") % (len(d["procs"]) - 8)))

    rows.append(rgb(*heat(avg_util), BL + H * inner + BR))
    return tint(rows, zone_bg(avg_util))


EIGHTHS = " ▁▂▃▄▅▆▇█"


DISK_ALERT = 90          # 根目錄用到這個 % 以上就警示


def disk_net(d, width=999):
    """「DSK ▕██░░▏ 42.0%  738G/1.7T   NET ↓1.2M/s ↑300K/s」，兩個都讀不到就是空字串。

    面板窄的時候依序省掉容量、長條，網速一定留著。
    """
    disk, net = d.get("disk"), d.get("net")
    if not disk and "net" not in d:
        return ""
    down, up = ("v", "^") if _ascii else ("↓", "↑")
    if net:
        nt = (f"{dim(cyan('NET'))} {down}{fmt_bytes(net[0], '/s'):>8} "
              f"{up}{fmt_bytes(net[1], '/s'):>8}")
    else:                                         # 第一次取樣，還沒有速度
        nt = f"{dim(cyan('NET'))} {grey('-')}"
    if not disk:
        return f" {dim(cyan('DSK'))} {grey('-')}   " + nt
    pct = disk["pct"]
    txt = f"{pct:5.1f}%"
    if pct >= DISK_ALERT:
        txt = rgb(231, 76, 60, bold(txt))
    size = dim(fmt_bytes(disk["used"]) + "/" + fmt_bytes(disk["total"]))
    for dk in (f" {dim(cyan('DSK'))} {gradbar(pct)} {txt}   {size}",
               f" {dim(cyan('DSK'))} {gradbar(pct)} {txt}",
               f" {dim(cyan('DSK'))} {txt}"):
        out = dk + "   " + nt
        if vlen(out) <= width:
            break
    return out


def owner_tag(node, g):
    """GPU 列最後面：[閒置] job 使用者。不是 Slurm 起的行程只顯示（擁有者）。"""
    jid, user = gpu_owner(node, g)
    out = ""
    if idle_held(node, g):
        out += " " + rgb(241, 196, 15, bold(T("idle_tag")))
    if jid:
        out += " " + cyan(jid) + (" " + dim(user) if user else "")
    elif user:
        out += " " + dim("(%s)" % user)
    elif g.get("model"):                         # 沒有人佔用時，至少告訴你這是哪張卡
        out += " " + dim(g["model"])
    return out


RED, YELLOW = (231, 76, 60), (241, 196, 15)


def alerts(nodes, snaps, ages=None):
    """有問題的機器，依嚴重程度排好：[(顏色, 文字)]。

    斷線 > GPU 過熱 > 磁碟快滿 > 資料過時 > 佔著卻閒置。
    """
    ages = ages or [None] * len(nodes)
    down, hot, disk, stale = [], [], [], []
    for node, d, age in zip(nodes, snaps, ages):
        if not d:
            down.append((RED, f"{node} {T('alert_down')}"))
            continue
        if age is not None:
            stale.append((YELLOW, f"{node} " + T("stale") % age))
        hg = [g for g in d["gpus"] if g["temp"] is not None and g["temp"] >= ALERT_TEMP]
        if hg:
            gs = ",".join("G" + g["idx"] for g in hg)
            hot.append((RED, f"{node} {gs} " + T("alert_hot") % max(g["temp"] for g in hg)))
        dk = d.get("disk")
        if dk and dk["pct"] >= DISK_ALERT:
            disk.append((RED, f"{node} " + T("alert_disk") % dk["pct"]))
    idle = []
    for node, idx, jid, user in idle_alerts(nodes, snaps):
        who = " ".join(x for x in (jid, user) if x)
        gs = ",".join("G" + i for i in idx)
        idle.append((YELLOW, f"{node} {gs} {T('idle_alert')}" + (f" ({who})" if who else "")))
    return down + hot + disk + stale + idle


def alert_line(nodes, snaps, width, ages=None):
    """頂端警示列：一行列出有問題的機器，放不下的收成「+N」；沒有問題就不佔任何一行。"""
    items = alerts(nodes, snaps, ages)
    if not items:
        return []
    worst = RED if any(c == RED for c, _ in items) else YELLOW
    head = "  " + rgb(*worst, bold("!" if _ascii else "⚠")) + " "
    sep = dim(" · ")
    shown = []
    for i, (col, txt) in enumerate(items):
        rest = len(items) - i - 1
        more = (sep + dim(T("alert_more") % rest)) if rest else ""
        cand = head + sep.join(shown + [rgb(*col, txt)]) + more
        if vlen(cand) > width and shown:
            break
        shown.append(rgb(*col, txt))
    rest = len(items) - len(shown)
    line = head + sep.join(shown) + ((sep + dim(T("alert_more") % rest)) if rest else "")
    return [clip(line, width)]


def scope(vals, width, height=6):
    """示波器：像心電圖一樣循環掃描，寫入頭在畫面上跑，舊資料留在右邊。

    每格用八分之一方塊做次像素解析度，所以 6 行能表現 48 級。
    """
    v = list(vals)
    slots = [None] * width
    for i, x in enumerate(v):
        slots[i % width] = x
    head = (len(v) - 1) % width if v else -1

    rows = []
    for r in range(height):
        base = (height - 1 - r) * 8            # 這行代表的底部高度（單位：八分之一格）
        line = []
        for i, x in enumerate(slots):
            if x is None:                      # 還沒掃到的區域
                line.append(grey("." if _ascii else "·"))
                continue
            level = max(0.0, min(100.0, x)) / 100 * height * 8
            f = level - base
            if f <= 0:
                ch, col = ("." if _ascii else "·"), None
            elif f >= 8:
                ch, col = ("#" if _ascii else "█"), heat(x)
            else:
                ch, col = ("+" if _ascii else EIGHTHS[int(f)]), heat(x)
            if i == head:                      # 寫入頭：整欄提亮
                line.append(rgb(150, 245, 255, ch if ch != "·" else ("|" if _ascii else "│")))
            elif col is None:
                line.append(grey(ch))
            else:
                line.append(rgb(*col, ch))
        rows.append("".join(line))
    return rows


def trace(border, tick_offset=0):
    """讓一顆亮點沿著邊框跑，像電路上的訊號（--flair）。"""
    if not _flair or _ascii or vlen(border) < 8:
        return border
    plain = ANSI.sub("", border)
    idx = 2 + (_tick * 2 + tick_offset) % max(1, len(plain) - 4)
    if plain[idx] not in "─═┈":
        return border

    # 要在「原字串」裡找到第 idx 個可見字元的位置。直接拿 plain 的索引去切
    # 原字串會切進 ANSI 序列中間，把顏色碼截斷成亂碼。
    raw, seen = 0, 0
    while raw < len(border):
        if border[raw] == "\033":
            end = border.find("m", raw)
            if end == -1:
                break
            raw = end + 1
            continue
        if seen == idx:
            return border[:raw] + rgb(120, 240, 255, "━") + border[raw + 1:]
        seen += 1
        raw += 1
    return border


REPO_URL = "https://github.com/Sean-Hawks/slurmtop"


def qr_lines(quiet=4, wide=False):
    """把內嵌的 QR 畫成可掃描的文字。

    預設用半形方塊：一個字元格放上下兩個模組（前景畫上面、背景畫下面），
    模組是 1 格寬 x 半格高。一般終端機的字元格約 1:2，所以模組接近正方形；
    實測長寬比 1.8~2.4 之間都解得出來。這也是 `qrencode -t ANSIUTF8` 的做法。

    wide=True 改成一個模組兩個字元寬、一列高，只用背景色，完全不依賴
    方塊字符的字型覆蓋範圍。寬度變兩倍，給字型會讓 ▀ 留縫的終端機用。
    """
    grid = []
    for r in QR_ROWS:
        bits = bin(int(r, 16))[2:].zfill(QR_SIZE)
        grid.append([0] * quiet + [int(b) for b in bits] + [0] * quiet)
    pad_row = [0] * (QR_SIZE + quiet * 2)
    grid = [list(pad_row) for _ in range(quiet)] + grid + \
           [list(pad_row) for _ in range(quiet)]

    if wide or _ascii:
        if _ascii:
            return ["".join("██" if c else "  " for c in row) for row in grid]
        dark, light = "\033[48;2;0;0;0m  ", "\033[48;2;255;255;255m  "
        return ["".join(dark if c else light for c in row) + "\033[0m"
                for row in grid]

    if len(grid) % 2:                              # 補成偶數列才好兩兩配對
        grid.append(list(pad_row))
    if not _color:
        # --no-color 不能用色碼，改用前景字元畫「亮」的模組、暗的留給背景。
        # 深色背景的終端機上就是正常黑白的 QR；淺色背景會變成反相。
        halves = {(0, 0): "█", (0, 1): "▀", (1, 0): "▄", (1, 1): " "}
        return ["".join(halves[(top, bot)] for top, bot in zip(grid[y], grid[y + 1]))
                for y in range(0, len(grid), 2)]
    out = []
    for y in range(0, len(grid), 2):
        line = ""
        for x in range(len(grid[0])):
            fg = "0;0;0" if grid[y][x] else "255;255;255"
            bg = "0;0;0" if grid[y + 1][x] else "255;255;255"
            line += f"\033[38;2;{fg}m\033[48;2;{bg}m▀"
        out.append(line + "\033[0m")
    return out


QR_QUIET = 4
QR_W = QR_SIZE + QR_QUIET * 2 + 2         # 半形方塊：一模組一欄 + 兩側外框


def qr_panel(height):
    """右下角的 QR 區塊：外面包一層取景框，白底靜區完整保留才掃得到。"""
    body = qr_lines(QR_QUIET)
    inner = QR_SIZE + QR_QUIET * 2

    head = f"{dim(cyan('┤'))} {bold(cyan('SCAN'))} {dim(cyan('├'))}"
    rows = [head + dim(cyan("─" * max(0, QR_W - vlen(head))))]

    # 取景框：四角用括號，邊線暗青色，都在白色靜區之外，不影響掃描
    rows.append(cyan("⌜") + dim(cyan("─" * inner)) + cyan("⌝"))
    for line in body:
        rows.append(dim(cyan("│")) + line + dim(cyan("│")))
    rows.append(cyan("⌞") + dim(cyan("─" * inner)) + cyan("⌟"))

    url = REPO_URL.split("//", 1)[1]               # 去掉 https:// 才置中得下
    rows.append(pad("", max(0, (QR_W - len(url)) // 2)) + dim(cyan(url)))

    while len(rows) < height:
        rows.append("")
    return rows


def show_qr(wide=False):
    print()
    for line in qr_lines(QR_QUIET, wide):
        print("  " + line)
    print()
    print("  " + bold(cyan(REPO_URL)))
    print("  " + dim(f"slurmtop {__version__} · credited by {__credits__}"))
    print()


def splash(nodes):
    """開機動畫。純裝飾，只有 --flair 才播，--no-splash 可再關掉。"""
    steps = [
        "probing slurm controller",
        f"discovering nodes ... {len(nodes)} found",
        "opening telemetry links",
        "arming sparkline buffers",
        "link established",
    ]
    W = 62
    for i in range(len(steps) * 3):
        step = steps[min(i // 3, len(steps) - 1)]
        # 每幀讓 logo 的顏色掃過去一次，做出通電感
        t = (i % 6) / 5
        col = tuple(int(86 + (255 - 86) * t * f) for f in (1, 0.5, 0.2))
        col = (min(255, col[0]), min(255, 211 + col[1] // 8), min(255, 240))
        body = big("SLURMTOP", col)
        done = int((i + 1) / (len(steps) * 3) * (W - 2))
        bar = (rgb(86, 211, 240, "█" * done) + grey("░" * (W - 2 - done)))
        frame = ["", *["   " + b for b in body], "",
                 "   " + cyan("[") + bar + cyan("]"),
                 "   " + dim("· " + step + " ..."), ""]
        sys.stdout.write("\033[H\033[J" + "\n".join(frame))
        sys.stdout.flush()
        time.sleep(0.07)


def cpu_header(live, width):
    """沒有任何 GPU 時的總覽列：主指標換成 CPU。"""
    avg = sum(d["cpu_pct"] for d in live) / len(live)
    cores = sum(d["ncpu"] for d in live)
    mem_u = sum(d["mem_used"] for d in live) / 1024
    mem_t = sum(d["mem_total"] for d in live) / 1024

    tag = f" {bold(cyan('SLURMTOP'))} {dim('//')} {bold(_title)} "
    clk = f" {dim(clock())} "
    fill = max(0, width - vlen(tag) - vlen(clk) - 2)
    out = [cyan("◤") + tag + dim("─" * fill) + clk + cyan("◥")]

    lab = lambda t: dim(cyan(f"{t:<5}"))
    gauge = [
        "  " + arc_gauge(avg),
        "  " + pad(f"{bold('%.1f%%' % avg)} {dim(cyan('CPU'))}", 17),
        "  " + pad(f"{trend(('all', 'gpu'), avg)} {spark(hist(('all', 'gpu')), 12)}", 17),
    ]
    tele = [
        f"{lab('CORE')} {bold(str(len(live)))} {dim('nodes')} {dim('·')} "
        f"{cores} {dim(T('threads'))}",
        f"{lab('CPU')}  {gradbar(avg, 18, avg >= 90)} {bold('%5.1f%%' % avg)} "
        f"{trend(('all', 'gpu'), avg)}  {spark(hist(('all', 'gpu')), 12)}",
        f"{lab('MEM')}  {mem_u:.0f}{dim('/')}{mem_t:.0f} GiB   {dim(T('no_gpu'))}",
    ]
    for i in range(max(len(gauge), len(tele))):
        left = gauge[i] if i < len(gauge) else ""
        out.append(pad(left, 20) + (tele[i] if i < len(tele) else ""))
    return out


def cluster_header(snaps, width):
    """HUD 主讀數：七段大字 + 遙測列 + 全叢集 GPU 格點圖。"""
    live = [d for d in snaps if d]
    gpus = [g for d in live for g in d["gpus"]]
    if not live:
        return [rgb(231, 76, 60, "NO TELEMETRY")]
    if not gpus:                                   # CPU-only 叢集
        return cpu_header(live, width)
    st = gpu_stats(gpus)
    avg = st["util"] or 0.0                        # 畫儀表用；數字照實顯示 "-"
    busy, power, tmax = st["busy"], st["power"], st["tmax"]

    # 頂列：◤ SLURMTOP ── cluster ─────────── 時間 ◥
    tag = f" {bold(cyan('SLURMTOP'))} {dim('//')} {bold(_title)} "
    clk = f" {dim(clock())} "
    fill = max(0, width - vlen(tag) - vlen(clk) - 2)
    out = [cyan("◤") + tag + dim("─" * fill) + clk + cyan("◥")]

    # 左邊弧形儀表，右邊遙測欄
    lab = lambda t: dim(cyan(f"{t:<5}"))
    gauge = [
        "  " + arc_gauge(avg),
        "  " + pad(f"{bold(fnum(st['util'], '%.1f%%'))} {dim(cyan('UTIL'))}", 17),
        "  " + pad(f"{trend(('all', 'gpu'), avg)} {spark(hist(('all', 'gpu')), 12)}", 17),
    ]
    tele = [
        f"{lab('CORE')} {bold(str(busy))}/{len(gpus)} {dim('online')}"
        + (("   " + blink("◆ FULL LOAD", (255, 170, 40))) if avg >= 90 else ""),
        f"{lab('PWR')}  {mag(fnum(power / 1000 if power is not None else None, '%.2f kW'))}   "
        f"{lab('MEM')} {st['vram_u']:.0f}{dim('/')}{st['vram_t']:.0f} GiB   "
        f"{lab('THRM')} "
        + (rgb(*temp_color(tmax), '%d°C' % tmax) if tmax is not None else grey("-"))
        + (("  " + blink("▲ THERMAL", (231, 76, 60)))
           if tmax is not None and tmax >= ALERT_TEMP else ""),
        f"{lab('GRID')} " + grid_strips(snaps, width - 27),
    ]
    for i in range(3):
        out.append(clip(pad(gauge[i], 21) + tele[i], width))
    return out


def grid_strips(snaps, width):
    """每台一段燈號，中間用 │ 隔開；節點多到放不下時改用單一空白隔開。"""
    strips = [gpu_strip(d["gpus"]) for d in snaps if d and d["gpus"]]
    for sep in ("  " + dim("│") + "  ", " ", ""):
        line = sep.join(strips)
        if vlen(line) <= width:
            break
    return line


def progress(elapsed, limit, width=8):
    """job 已用掉多少時間上限。快到上限會轉紅。"""
    e, l = dur_sec(elapsed), dur_sec(limit)
    if not l or e is None:
        return grey(("." if _ascii else "·") * width)
    pct = min(100.0, 100.0 * e / l)
    _, full, empty, _, _ = glyphs()
    filled = int(round(pct / 100 * width))
    col = pulse(heat(pct), 0.3) if pct >= 85 else heat(pct)
    return rgb(*col, full * filled) + grey(empty * (width - filled))


GRES_GPU = re.compile(r"^(?:gres[:/])?gpu(?::([^:]+))?(?::(\d+))?$")


def gpu_count(gres):
    """squeue %b 裡的 GPU 張數，沒有 GPU 回傳 None。

    各版 Slurm 的寫法都要認得：gres:gpu:8（舊版）、gres/gpu:8（新版 TRES）、
    gres/gpu:h200:8（帶型號）、後面可能接 (IDX:0-7)，也可能跟別的 gres 用逗號
    串在一起（gres/gpu:4,gres/shard:2）。只寫型號沒寫數量時算 1 張。
    """
    total, found = 0, False
    for item in re.sub(r"\([^)]*\)", "", gres or "").split(","):
        m = GRES_GPU.match(item.strip())
        if not m:
            continue
        found = True
        kind, count = m.groups()
        if count:
            total += int(count)
        elif kind and kind.isdigit():         # gpu:8 -> 第一段就是數量
            total += int(kind)
        else:                                 # gpu 或 gpu:h200 -> 1 張
            total += 1
    return total if found else None


def job_cell(f, narrow, where_w=20):
    """一個 job 的一列字串。narrow 用在多欄排版。"""
    jid, name, st, elapsed, left, nodes, cpus, gres, where = f[:9]
    limit = f[9] if len(f) > 9 else ""
    user = f[10] if len(f) > 10 else ""
    if st == "R":
        badge = rgb(46, 204, 113, spinner() + " " + T("run"))
    elif st == "PD":
        badge = rgb(241, 196, 15, ("." if _ascii else "◌") + " " + T("pend"))
    else:
        badge = grey(f"o {st}" if _ascii else f"○ {st}")
    n = gpu_count(gres)
    gpu = "-" if n is None else str(n)
    if narrow:
        return (f" {bold('%7s' % jid[:7])} {cell(name, 9)} {cell(dim(user), 6)} "
                f"{pad(badge, 6)} "
                f"{pad(fmt_dur(elapsed), 7)} {progress(elapsed, limit, 5)} "
                f"{pad(fmt_dur(left), 7)}{gpu:>2} {cyan(where[:where_w])}")
    return (f"  {bold('%7s' % jid[:7])}  {cell(name, 11)} {cell(dim(user), 8)} "
            f"{pad(badge, 7)} "
            f"{pad(fmt_dur(elapsed), 9)} {progress(elapsed, limit)} "
            f"{pad(fmt_dur(left), 9)} "
            f"{nodes:>2} {cpus:>4} {gpu:>4}  {cyan(where[:where_w])}")


# WHERE 之前所有欄位的固定寬度（多欄時的窄版 / 單欄的寬版）
JOB_FIXED_NARROW = 53
JOB_FIXED_WIDE = 84


def job_header(narrow):
    # 標題可能是中文，一律用 pad/rpad/cell 依顯示寬度對齊
    if narrow:
        return (f" {rpad(T('job'), 7)} {cell(T('name'), 9)} {cell(T('user'), 6)} "
                f"{pad(T('state'), 6)} "
                f"{pad(T('used'), 7)} {pad(T('prog'), 5)} "
                f"{pad(T('left'), 7)}{rpad(T('gpu'), 2)} {T('where')}")
    return (f"  {rpad(T('job'), 7)}  {cell(T('name'), 11)} {cell(T('user'), 8)} "
            f"{pad(T('state'), 7)} "
            f"{pad(T('used'), 9)} {pad(T('prog'), 8)} {pad(T('left'), 9)} "
            f"{rpad(T('nd'), 2)} {rpad(T('cpu'), 4)} {rpad(T('gpu'), 4)}  {T('where')}")


def slurm_section(width, max_rows=99, job_cols=1, data=None, user=None, age=None):
    """回傳 (畫面行, 沒顯示到的 job 數)。job_cols>1 時佇列會排成多欄；user 只列他的 job；
    age 不是 None 表示 squeue 這次沒回應，顯示的是舊資料。"""
    inner = width - 2
    rows = []
    stale = (" " + rgb(*YELLOW, T("stale") % age)) if age is not None else ""
    title = f"{dim(cyan('┤'))} {bold(T('queue'))}{stale} {dim(cyan('├'))}"
    rows.append(trace(TL + title + H * max(0, inner - vlen(title)) + TR, 3))

    def line(c):
        rows.append(V + pad(clip(c, inner), inner) + V)

    hidden = 0
    raw, info = data[0], data[1]
    parsed = parse_queue(raw)
    if user:
        parsed = [f for f in parsed if len(f) > 10 and f[10] == user]
    if not parsed:
        line(dim("  " + T("no_jobs")))
    else:
        narrow = job_cols > 1
        colw = inner // job_cols

        fixed = JOB_FIXED_NARROW if narrow else JOB_FIXED_WIDE
        where_w = max(4, colw - fixed)
        line(dim("".join(pad(clip(job_header(narrow), colw - 1), colw)
                             for _ in range(job_cols))))
        cap = max(job_cols, max_rows * job_cols)
        hidden = max(0, len(parsed) - cap)
        cells = [job_cell(f, narrow, where_w) for f in parsed[:cap]]
        for i in range(0, len(cells), job_cols):
            group = cells[i:i + job_cols]
            line("".join(pad(clip(c, colw - 1), colw) for c in group))
        if hidden:
            line(dim("  " + T("hidden") % hidden))

    if info:
        line(dim(" " + "┈" * (inner - 2)))
        seen = set()
        for ln in info.splitlines():
            n, state, c, m = (ln.split("|") + ["", "", "", ""])[:4]
            if n in seen:      # sinfo -N 每個佇列列一次，同一台只顯示一行
                continue
            seen.add(n)
            alloc, idle, other, total = (c.split("/") + ["0"] * 4)[:4]
            free_mb = (m.split("/") + ["0"])[0]
            free_gib = int(free_mb) / 1024 if free_mb.isdigit() else 0
            pct = 100 * int(alloc) / int(total) if total.isdigit() and int(total) else 0
            # 對齊一律用 pad()：f"{bold(n):<10}" 會把色碼算進寬度，彩色時整行錯位
            line(f"  {pad(bold(n), 10)} {pad(state, 8)} CPU {gradbar(pct, 10)} {alloc}/{total} "
                 f"{dim(T('idle') + ' ' + idle)}   "
                 f"{dim('RAM ' + T('free') + ' %.0f GiB' % free_gib)}")
    rows.append(BL + H * inner + BR)
    return rows, hidden


IDLE_UTIL = 5            # 使用率低於這個 % 算閒置
IDLE_SAMPLES = 30        # 連續幾次取樣都閒置，才算「佔著卻閒置」（--idle-samples）

# 每次刷新由 update_state() 算好，繪圖函式只讀
_owners = {}             # (節點, GPU 編號) -> [job id]：這張卡屬於哪些 job
_jobinfo = {}            # job id -> {id: 顯示用 id, user, name}
_idle = {}               # (節點, GPU 編號) -> (job id 們, 連續閒置次數)
_idle_n = IDLE_SAMPLES


def update_state(nodes, snaps, ages=None, slurm_data=None, idle_n=IDLE_SAMPLES):
    """每次刷新只呼叫一次：歷史、GPU 屬於哪個 job、閒置計數，都在這裡更新。"""
    global _idle_n
    _idle_n = max(1, idle_n)
    ages = ages or [None] * len(nodes)
    data = tuple(slurm_data or ()) + ("", "", "")
    queue = parse_queue(data[0])
    alloc, alloc_users = parse_alloc(data[2])
    _jobinfo.clear()
    for jid, u in alloc_users.items():
        _jobinfo[jid] = {"id": jid, "user": u, "name": ""}
    _jobinfo.update(job_table(queue))

    # 這張卡屬於誰：Slurm 的分配（沒有行程也算）+ 卡上行程的 cgroup
    _owners.clear()
    for node, d in zip(nodes, snaps):
        for g in (d or {}).get("gpus", []):
            jobs = list(alloc.get((node, g["idx"]), []))
            jobs += [j for j in g["jobs"] if j not in jobs]
            _owners[(node, g["idx"])] = jobs

    # 閒置計數只看新鮮的取樣；換了 job 就從頭算
    for node, d, age in zip(nodes, snaps, ages):
        if not d or age is not None:
            continue
        for g in d["gpus"]:
            key = (node, g["idx"])
            jobs = tuple(_owners.get(key, ()))
            u = g["util"]
            if jobs and u is not None and u < IDLE_UTIL:
                prev_jobs, n = _idle.get(key, ((), 0))
                _idle[key] = (jobs, n + 1 if prev_jobs == jobs else 1)
            else:
                _idle.pop(key, None)
    update_history(nodes, snaps, ages)


def gpu_owner(node, g):
    """(job 顯示字串或 None, 使用者或 None)。不是 Slurm job 的行程只回報行程擁有者。"""
    jobs = _owners.get((node, g["idx"]), [])
    if jobs:
        info = _jobinfo.get(jobs[0], {})
        jid = info.get("id") or jobs[0]
        if len(jobs) > 1:
            jid += "+%d" % (len(jobs) - 1)
        return jid, info.get("user") or None
    return None, (g["users"][0] if g["users"] else None)


def idle_held(node, g):
    """有 job 佔著、但最近 _idle_n 次取樣使用率都低於 IDLE_UTIL%。"""
    return _idle.get((node, g["idx"]), ((), 0))[1] >= _idle_n


def gpu_users(node, g):
    """這張卡相關的所有使用者（job 的提交者 + 卡上行程的擁有者），給 --me 用。"""
    users = [(_jobinfo.get(j) or {}).get("user") for j in _owners.get((node, g["idx"]), [])]
    return set(u for u in users + g["users"] if u)


def idle_alerts(nodes, snaps):
    """頂端警示用：[(節點, [GPU 編號], job 顯示字串, 使用者)]。"""
    out = []
    for node, d in zip(nodes, snaps):
        groups = {}
        for g in (d or {}).get("gpus", []):
            if idle_held(node, g):
                jid, user = gpu_owner(node, g)
                groups.setdefault((jid, user), []).append(g["idx"])
        for (jid, user), idx in groups.items():
            out.append((node, idx, jid, user))
    return out


def update_history(nodes, snaps, ages=None):
    """每次刷新只呼叫一次，在拿到 snapshot 之後。

    歷史（sparkline、趨勢箭頭、示波器）只在這裡寫入。render() 為了挑版面會把
    _frame() 畫好幾遍，所以繪圖函式一律只讀，不然一次刷新會寫進好幾筆。
    沿用舊資料（stale）的節點沒有新的取樣，不寫進它自己的歷史。
    """
    ages = ages or [None] * len(nodes)
    # 讀不到的使用率（None）不寫進歷史，sparkline 只畫真的量到的值
    for node, d, age in zip(nodes, snaps, ages):
        if not d or age is not None:
            continue
        _hist[(node, "cpu")].append(d["cpu_pct"])
        avg = gpu_stats(d["gpus"])["util"] if d["gpus"] else d["cpu_pct"]
        if avg is not None:
            _hist[(node, "gpu")].append(avg)
        for g in d["gpus"]:                    # 每張卡的歷史一定要更新，即使沒畫出來
            if g["util"] is not None:
                _hist[(node, f"g{g['idx']}")].append(g["util"])
    live = [d for d in snaps if d]
    if not live:
        return
    gpus = [g for d in live for g in d["gpus"]]
    # 全叢集那條：有 GPU 看 GPU 平均，CPU-only 叢集改看 CPU 平均，示波器照畫
    avg = gpu_stats(gpus)["util"] if gpus else sum(d["cpu_pct"] for d in live) / len(live)
    if avg is not None:
        _hist[("all", "gpu")].append(avg)


def my_user():
    try:
        return getpass.getuser()
    except Exception:
        return os.environ.get("USER", "")


def only_mine(nodes, snaps, ages, me):
    """--me：只留 me 佔用（job 是他的，或卡上有他的行程）的 GPU；一張都沒有的節點整台拿掉。"""
    keep = [], [], []
    for n, d, a in zip(nodes, snaps, ages):
        if not d:
            continue
        gpus = [g for g in d["gpus"] if me in gpu_users(n, g)]
        if not gpus:
            continue
        uuids = set(g["uuid"] for g in gpus)
        keep[0].append(n)
        keep[1].append(dict(d, gpus=gpus, procs=[p for p in d["procs"] if p["gpu"] in uuids]))
        keep[2].append(a)
    return keep


def sample(nodes, opt):
    """取樣一次並更新狀態（歷史、GPU 歸屬、閒置計數），回傳這次刷新的資料。

    終端機畫面、--json、網頁、Prometheus、--report 都用這一份，所以一次刷新只取樣一次。
    """
    # 各節點和 Slurm 同時抓，每個最多等 --node-timeout 秒；卡住的沿用上一筆
    jobs = {("node", n): (snapshot, n) for n in nodes}
    jobs[("slurm",)] = (slurm_query, None)
    timeout = opt.node_timeout
    if timeout is None:
        timeout = ONCE_TIMEOUT if getattr(opt, "once", False) else NODE_TIMEOUT
    got = fetch(jobs, timeout)
    snaps = [got[("node", n)][0] for n in nodes]
    ages = [got[("node", n)][1] for n in nodes]
    slurm_data, slurm_age = got[("slurm",)]
    slurm_ok = slurm_data is not None          # 沒裝 Slurm（或控制器一直連不上）就不顯示佇列
    slurm_data = slurm_data or ("", "", "")
    update_state(nodes, snaps, ages, slurm_data, opt.idle_samples)
    return {"nodes": list(nodes), "snaps": snaps, "ages": ages, "slurm": slurm_data,
            "slurm_age": slurm_age, "slurm_ok": slurm_ok, "time": _now()}


def render(nodes, opt=None, sampled=None, **kw):
    """取樣（或用現成的 sampled）並畫一整個畫面。opt 是 parse_args() 的結果；測試可以只給 kw。"""
    opt = opt or options(**kw)
    show_proc, force_stack, fit, want_qr = opt.proc, opt.stack, opt.fit, opt.qr_panel
    size = shutil.get_terminal_size((120, 45))
    cols, lines = size.columns, size.lines
    sparks = cols >= 118
    global _tick
    _tick += 1
    sm = sampled or sample(nodes, opt)
    nodes, snaps, ages = sm["nodes"], sm["snaps"], sm["ages"]
    slurm_data, slurm_age = sm["slurm"], sm["slurm_age"]
    slurm_ok = sm.get("slurm_ok", True)
    head_snaps = snaps
    me = my_user() if opt.me else None
    if me:                                  # --me：只留自己佔用的 GPU 和自己的 job
        nodes, snaps, ages = only_mine(nodes, snaps, ages, me)
    dense = want_dense(opt, nodes, snaps, ages, cols, lines, sparks)

    if not fit:
        # 預設：每張卡的明細與整個佇列都完整顯示，畫面長一點沒關係。
        # 佇列先用單欄；若這樣塞不進視窗，改多欄試著擠進去，但絕不收合或裁切。
        # 多欄沒有比較矮就不要用（例如佇列很短、是節點資源那段太長）
        best = None
        for jcols in (1, 2, 3):
            if jcols > 1 and cols < JOB_FIXED_NARROW * jcols:
                break
            frame, _ = _frame(nodes, snaps, cols, 10 ** 6, show_proc, force_stack,
                              sparks, compact=False, job_cols=jcols,
                              slurm_data=slurm_data, want_qr=want_qr, ages=ages,
                              me=me, head_snaps=head_snaps, dense=dense,
                              slurm_age=slurm_age, slurm_ok=slurm_ok)
            if best is None or len(frame) < len(best[0]):
                best = (frame, jcols)
            if len(frame) <= lines:
                break
        frame, jcols = best
        spare = lines - len(frame) - 1          # 下面還空著就把示波器拉高
        if spare > 0:
            frame, _ = _frame(nodes, snaps, cols, 10 ** 6, show_proc, force_stack,
                              sparks, compact=False, job_cols=jcols,
                              slurm_data=slurm_data, want_qr=want_qr,
                              scope_h=6 + spare, ages=ages, me=me, head_snaps=head_snaps,
                              dense=dense, slurm_age=slurm_age, slurm_ok=slurm_ok)
        return "\n".join(frame)

    # --fit：硬塞進一頁。依序犧牲 sparkline -> 每張卡的明細 -> 佇列改多欄 -> 裁 job。
    plans = [(sparks, False, 1), (False, False, 1), (False, True, 1),
             (False, True, 2), (False, True, 3)]
    for sp, compact, jcols in plans:
        if jcols > 1 and cols < JOB_FIXED_NARROW * jcols:
            continue
        frame, hidden = _frame(nodes, snaps, cols, lines, show_proc, force_stack,
                               sp, compact, jcols, slurm_data=slurm_data,
                               want_qr=want_qr and not compact, ages=ages,
                               me=me, head_snaps=head_snaps, dense=dense,
                               slurm_age=slurm_age, slurm_ok=slurm_ok)
        if len(frame) <= lines and not hidden:
            break
    return "\n".join(frame[:lines])


JSON_HISTORY = 120      # --json／網頁每條歷史最多帶幾筆


def _r(v, nd=1):
    return None if v is None else round(v, nd)


def model(sm, opt=None):
    """把 sample() 的結果整理成純資料（可以直接 json.dumps），給 --json、網頁、報告用。

    數值一律用原始單位：記憶體 MiB、功耗 W、溫度 °C、磁碟 bytes、網速 bytes/s。
    讀不到的值是 null。--me 的篩選在這裡也一樣套用。
    """
    nodes, snaps, ages = sm["nodes"], sm["snaps"], sm["ages"]
    queue = parse_queue(sm["slurm"][0])
    me = my_user() if opt is not None and getattr(opt, "me", False) else None
    all_gpus = [g for d in snaps if d for g in d["gpus"]]
    live = [d for d in snaps if d]
    st = gpu_stats(all_gpus)
    summary = {
        "nodes": len(nodes), "nodes_up": len(live), "gpus": st["n"], "gpus_busy": st["busy"],
        "gpu_util": _r(st["util"]), "power_w": _r(st["power"]), "gpu_temp_max": _r(st["tmax"], 0),
        "vram_used_mib": _r(st["vram_u"] * 1024, 0), "vram_total_mib": _r(st["vram_t"] * 1024, 0),
        "cpu_pct": _r(sum(d["cpu_pct"] for d in live) / len(live)) if live else None,
        "mem_used_mib": sum(d["mem_used"] for d in live),
        "mem_total_mib": sum(d["mem_total"] for d in live),
    }
    if me:
        nodes, snaps, ages = only_mine(nodes, snaps, ages, me)
        queue = [f for f in queue if len(f) > 10 and f[10] == me]
    out_nodes = []
    for node, d, age in zip(nodes, snaps, ages):
        n = {"name": node, "up": bool(d), "stale_s": _r(age, 0)}
        if d:
            gpus = []
            for g in d["gpus"]:
                jid, user = gpu_owner(node, g)
                gpus.append({
                    "index": g["idx"], "uuid": g.get("uuid"), "vendor": g.get("vendor", "nvidia"),
                    "model": g.get("model"), "util": _r(g["util"]),
                    "mem_used_mib": _r(g["mem_used"], 0), "mem_total_mib": _r(g["mem_total"], 0),
                    "temp_c": _r(g["temp"], 0), "power_w": _r(g["power"]),
                    "job": jid, "user": user, "idle_held": idle_held(node, g),
                    "history": [_r(x) for x in list(hist((node, "g" + g["idx"])))[-JSON_HISTORY:]],
                })
            disk, net = d.get("disk"), d.get("net")
            n.update({
                "local": is_local(node), "cpu_pct": _r(d["cpu_pct"]), "load": d["load"],
                "cpus": d["ncpu"], "mem_used_mib": d["mem_used"], "mem_total_mib": d["mem_total"],
                "disk": ({"pct": _r(disk["pct"]), "used": int(disk["used"]),
                          "total": int(disk["total"])}
                         if disk else None),
                "net": {"rx": _r(net[0], 0), "tx": _r(net[1], 0)} if net else None,
                "gpus": gpus,
                "history": {k: [_r(x) for x in list(hist((node, k)))[-JSON_HISTORY:]]
                            for k in ("cpu", "gpu")},
            })
        out_nodes.append(n)
    keys = ("id", "name", "state", "elapsed", "left", "nodes", "cpus", "gres", "where",
            "limit", "user", "job_id")
    jobs = []
    for f in queue:
        j = dict(zip(keys, f))
        j["gpus"] = gpu_count(j.get("gres"))
        for k in ("elapsed", "left", "limit"):      # 秒數，方便其他工具計算
            j[k + "_s"] = dur_sec(j.get(k))
        jobs.append(j)
    return {
        "version": __version__, "time": sm["time"], "cluster": _title, "summary": summary,
        "nodes": out_nodes, "slurm": sm.get("slurm_ok", True), "queue": jobs,
        "queue_stale_s": _r(sm["slurm_age"], 0),
        "alerts": [{"level": "red" if c == RED else "warn", "text": t}
                   for c, t in alerts(nodes, snaps, ages)],
        "history": [_r(x) for x in list(hist(("all", "gpu")))[-JSON_HISTORY:]],
    }


def scope_section(width, height=6):
    """全叢集負載示波器。"""
    inner = width - 2
    n = len(hist(("all", "gpu")))
    title = (f"{dim(cyan('┤'))} {bold('LOAD')} {dim('//')} "
             f"{dim('last %d samples' % min(n, inner - 2))} {dim(cyan('├'))}")
    rows = [trace(TL + title + H * max(0, inner - vlen(title)) + TR)]
    for line in scope(hist(("all", "gpu")), inner - 2, height):
        rows.append(V + " " + pad(line, inner - 2) + " " + V)
    rows.append(BL + H * inner + BR)
    return rows


MIN_PANEL_W = 49          # 一個節點面板至少要這麼寬才擺得下
DENSE_RESERVE = 12        # 節點面板比「畫面高度 - 這麼多行」還高時，自動改成密集檢視


def _layout(cols, n, force_stack):
    """(總寬, 一排幾個面板, 面板寬)。面板平均分掉整個寬度，不留右邊一大塊空白。"""
    total_w = max(MIN_PANEL_W, cols - 1)
    percol = 1 if force_stack else max(1, min(n, total_w // MIN_PANEL_W))
    panel_w = total_w // percol
    return panel_w * percol, percol, panel_w


def panels_height(nodes, snaps, ages, cols, show_proc, force_stack, sparks):
    """一般檢視下所有節點面板加起來有幾行高。"""
    _, percol, panel_w = _layout(cols, len(nodes), force_stack)
    hs = [len(node_panel(n, d, panel_w, show_proc, sparks and panel_w >= 58, False, a))
          for n, d, a in zip(nodes, snaps, ages or [None] * len(nodes))]
    return sum(max(hs[i:i + percol]) for i in range(0, len(hs), percol))


def want_dense(opt, nodes, snaps, ages, cols, lines, sparks):
    """--dense，或節點多到面板放不下畫面時（至少兩台）。"""
    if opt.dense:
        return True
    return len(nodes) > 1 and panels_height(nodes, snaps, ages, cols, opt.proc, opt.stack,
                                            sparks) > lines - DENSE_RESERVE


def dense_fields(node, d, age):
    """密集檢視的一列，切成欄位（對齊由 dense_panel 處理）。連不上的節點只有三欄。"""
    dot = "o" if _ascii else "◉"
    name = bold(cyan(node))
    if not d:
        return [name, rgb(*RED, dot), rgb(*RED, T("unreachable"))]
    has_gpu = bool(d["gpus"])
    st = gpu_stats(d["gpus"])
    load = (st["util"] or 0.0) if has_gpu else d["cpu_pct"]
    mem_pct = d["mem_used"] / d["mem_total"] * 100 if d["mem_total"] else 0
    f = [name, rgb(*heat(load), dot),
         f"{dim(cyan('CPU'))} {gradbar(d['cpu_pct'], 6)} {d['cpu_pct']:3.0f}%",
         f"{dim(cyan('MEM'))} {gradbar(mem_pct, 6)} {mem_pct:3.0f}%"]
    if has_gpu:
        tmax, pw = st["tmax"], st["power"]
        f += [f"{dim(cyan('GPU'))} {st['busy']}/{st['n']} {gpu_strip(d['gpus'])}",
              bold(fnum(st["util"], "%3.0f%%")),
              rgb(*temp_color(tmax), "%.0f°C" % tmax) if tmax is not None else grey("-"),
              mag(fnum(pw / 1000 if pw is not None else None, "%.1fkW"))]
    else:
        f += [dim(T("no_gpu")), "", "", ""]
    dk = d.get("disk")
    if dk:
        txt = "%3.0f%%" % dk["pct"]
        f.append(f"{dim(cyan('DSK'))} " + (rgb(*RED, bold(txt)) if dk["pct"] >= DISK_ALERT else txt))
    else:
        f.append(f"{dim(cyan('DSK'))} {grey('-')}")
    net = d.get("net")
    down, up = ("v", "^") if _ascii else ("↓", "↑")
    f.append(f"{dim(cyan('NET'))} " + (f"{down}{fmt_bytes(net[0], '/s'):>8} {up}{fmt_bytes(net[1], '/s'):>8}"
                                        if net else grey("-")))
    flags = []
    if age is not None:
        flags.append(rgb(*YELLOW, T("stale") % age))
    idle = sum(1 for g in d["gpus"] if idle_held(node, g))
    if idle:
        flags.append(rgb(*YELLOW, bold(T("idle_tag"))) + " %d" % idle)
    f.append(" ".join(flags))
    return f


def dense_panel(nodes, snaps, ages, width):
    """密集檢視：一台一行，各欄依整張表最寬的那格對齊。"""
    inner = width - 2
    title = (f"{dim(cyan('┤'))} {bold(T('nodes'))} {dim(str(len(nodes)))} {dim(cyan('├'))}")
    rows = [TL + title + H * max(0, inner - vlen(title)) + TR]
    table = [dense_fields(n, d, a) for n, d, a in zip(nodes, snaps, ages or [None] * len(nodes))]
    ncol = max(len(r) for r in table)
    full = [r for r in table if len(r) == ncol] or table
    widths = [max(vlen(r[i]) for r in full) for i in range(ncol)]
    widths[0] = max(vlen(r[0]) for r in table)
    for r in table:
        # 最後一格不補空白；連不上的那列欄位比較少，訊息直接接在燈號後面
        cells = [pad(c, widths[i]) for i, c in enumerate(r[:-1])] + [r[-1]]
        text = " " + "  ".join(cells)
        rows.append(V + pad(clip(text.rstrip(), inner), inner) + V)
    rows.append(BL + H * inner + BR)
    return rows


def _frame(nodes, snaps, cols, lines, show_proc, force_stack, sparks, compact,
           job_cols=1, slurm_data=("", ""), want_qr=False, scope_h=6, ages=None,
           me=None, head_snaps=None, dense=False, slurm_age=None, slurm_ok=True):
    # 版面填滿整個終端機：先決定一排放幾個面板，再把寬度平均分掉，
    # 而不是用固定寬度、右邊留一大塊空白。
    total_w, percol, panel_w = _layout(cols, len(nodes), force_stack or dense)
    sparks = sparks and panel_w >= 58

    ages = ages or [None] * len(nodes)
    if dense and nodes:                    # 密集檢視：一台一行，整個寬度一個面板
        total_w = panel_w = max(MIN_PANEL_W, cols - 1)
        panels = [dense_panel(nodes, snaps, ages, total_w)]
    else:
        panels = [node_panel(n, d, panel_w, show_proc, sparks, compact, age)
                  for n, d, age in zip(nodes, snaps, ages)]

    # 頂端的總覽永遠看整個叢集（--me 也一樣），下面的面板才是篩過的
    out = cluster_header(head_snaps if head_snaps is not None else snaps, total_w)
    out += alert_line(nodes, snaps, total_w, ages)
    if not compact:
        out += scope_section(total_w, scope_h)
    if me and not nodes:
        panels = [[TL + H * (total_w - 2) + TR,
                   V + pad(dim("  " + T("none_mine") % me), total_w - 2) + V,
                   BL + H * (total_w - 2) + BR]]
        percol = 1
    for start in range(0, len(panels), percol):
        group = panels[start:start + percol]
        h = max(len(p) for p in group)
        for i in range(h):
            out.append("".join(pad(p[i] if i < len(p) else "", panel_w) for p in group).rstrip())

    # 剩下的高度留給佇列：總高 - 已用 - Slurm 區塊固定開銷(6) - 頁尾(1) - 保險(1)
    budget = lines - len(out) - 8
    show_qr_panel = want_qr and not _ascii and cols >= total_w and total_w - QR_W >= 72
    qw = QR_W + 2 if show_qr_panel else 0
    if not slurm_ok:                           # 沒有 Slurm：整個佇列區塊不畫
        sec, hidden = [], 0
    elif show_qr_panel:
        # QR 區塊固定 20 行高，佇列比它矮的話排多欄一行都省不到，
        # 只會把欄位截斷。這種情況一律用單欄，看得清楚。
        one, hidden_one = slurm_section(total_w - qw, max_rows=max(1, budget),
                                        job_cols=1, data=slurm_data, user=me,
                                        age=slurm_age)
        # QR 旁邊剩下的寬度不夠每欄放下完整的窄版 job 列時，也維持單欄
        too_narrow = (total_w - qw - 2) // job_cols < JOB_FIXED_NARROW + 4
        if len(one) <= len(qr_panel(0)) or job_cols == 1 or too_narrow:
            sec, hidden = one, hidden_one
        else:
            sec, hidden = slurm_section(total_w - qw, max_rows=max(1, budget),
                                        job_cols=job_cols, data=slurm_data, user=me,
                                        age=slurm_age)
    else:
        sec, hidden = slurm_section(total_w - qw, max_rows=max(1, budget),
                                    job_cols=job_cols, data=slurm_data, user=me,
                                    age=slurm_age)
    if show_qr_panel:
        qr = qr_panel(len(sec))
        # QR 比佇列高的話，把佇列的框往下拉齊，不要在左邊留一塊空洞
        if len(qr) > len(sec) and sec:
            filler = V + " " * (total_w - qw - 2) + V
            sec = sec[:-1] + [filler] * (len(qr) - len(sec)) + [sec[-1]]
        for i in range(max(len(sec), len(qr))):
            left = sec[i] if i < len(sec) else ""
            right = qr[i] if i < len(qr) else ""
            out.append(pad(left, total_w - qw) + "  " + right)
    else:
        out += sec
    footer = "  " + T("footer")
    sign = dim(f"team-03/Hawks · v{__version__}")
    if vlen(footer) + vlen(sign) + 2 <= total_w:          # 擠不下就只留署名
        out.append(pad(dim(footer), total_w - vlen(sign)) + sign)
    else:
        out.append(pad("", max(0, total_w - vlen(sign))) + sign)
    return out, hidden


def cluster_name():
    for line in sh("scontrol show config", key="scontrol_config").splitlines():
        if line.startswith("ClusterName"):
            v = line.split("=", 1)[1].strip()
            if v and v != "(null)":
                return v
    return local_host() or "cluster"         # 沒有 Slurm（工作站、筆電）就用這台的主機名稱


