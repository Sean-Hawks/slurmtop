def rgb(r, g, b, s):
    return f"\033[38;2;{r};{g};{b}m{s}\033[0m" if _color else s


def sgr(code, s):
    return f"\033[{code}m{s}\033[0m" if _color else s


def bold(s):   return sgr("1", s)
