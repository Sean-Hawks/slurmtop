def rgb(r, g, b, s):
    return f"\033[38;2;{r};{g};{b}m{s}\033[0m" if _color else s


def sgr(code, s):
    return f"\033[{code}m{s}\033[0m" if _color else s


def bold(s):   return sgr("1", s)
def dim(s):    return sgr("2", s)
def grey(s):   return rgb(110, 118, 129, s)
def cyan(s):   return rgb(86, 211, 240, s)
def mag(s):    return rgb(199, 146, 234, s)


def heat(pct):
    """0% 綠 → 60% 黃 → 100% 紅 的漸層 RGB。"""
    pct = max(0.0, min(100.0, pct))
    if pct <= 60:
        t = pct / 60
        return (int(46 + (241 - 46) * t), int(204 + (196 - 204) * t), int(113 + (15 - 113) * t))
    t = (pct - 60) / 40
    return (int(241 + (231 - 241) * t), int(196 + (76 - 196) * t), int(15 + (60 - 15) * t))


def vlen(s):
    """扣掉 ANSI 顏色碼後的可見寬度（全形字算 2 格）。"""
    plain = ANSI.sub("", s)
    w = 0
    for ch in plain:
        w += 2 if unicodedata_wide(ch) else 1
    return w


def unicodedata_wide(ch):
    """終端機裡佔兩格的字：Unicode 東亞寬度是 W（寬）或 F（全形）。

    以前手寫碼位區間，漏了 emoji、CJK 擴充 B 以後的漢字等等。框線、方塊這類
    「A（模稜兩可）」的字元照大多數終端機的預設當一格。
    """
    return unicodedata.east_asian_width(ch) in ("W", "F")


def pad(s, width):
    return s + " " * max(0, width - vlen(s))


def rpad(s, width):
    """靠右對齊版的 pad()。f"{s:>n}" 只數字元數，碰到中文或色碼會歪。"""
    return " " * max(0, width - vlen(s)) + s


def cell(s, width):
    """固定寬度的欄位：太長裁掉、太短補空白，全形字也對得齊。"""
    return pad(clip(s, width), width)


def clip(s, width):
    """裁到指定可見寬度，ANSI 顏色碼不計入寬度、也不會被切斷。"""
    if vlen(s) <= width:
        return s
    out, w, i = [], 0, 0
    while i < len(s) and w < width:
        if s[i] == "\033":                          # 整段顏色碼原樣保留
            j = s.find("m", i)
            if j == -1:
                break
            out.append(s[i:j + 1]); i = j + 1
            continue
        cw = 2 if unicodedata_wide(s[i]) else 1
        if w + cw > width:
            break
        out.append(s[i]); w += cw; i += 1
    # 只有原字串帶色碼時才補 reset，--no-color 的輸出不能混進任何控制碼
    return "".join(out) + ("\033[0m" if "\033" in s else "")


def gradbar(pct, width=14, hot=False):
    """漸層長條：每一格依自身位置著色，填滿的部分才亮。hot=滿載，會呼吸。"""
    pct = max(0.0, min(100.0, pct))
    filled = int(round(pct / 100 * width))
    _, full, empty, lcap, rcap = glyphs()
    scan = _tick % (width * 2) if _flair else -1   # 掃描光點的位置（--flair）
    out = []
    for i in range(width):
        if i < filled:
            r, g, b = heat((i + 1) / width * 100)
            if hot:
                r, g, b = pulse((r, g, b), 0.28)
            if i == scan:                      # 掃到的那格提亮
                r, g, b = [min(255, int(c + (255 - c) * 0.65)) for c in (r, g, b)]
            out.append(rgb(r, g, b, full))
        else:
            out.append(grey(empty))
    return lcap + "".join(out) + rcap


def spark(vals, width=8):
    """歷史走勢圖（0-100 的數列）。"""
    chars = glyphs()[0]
    if not vals:
        return grey(("." if _ascii else "·") * width)
    v = list(vals)[-width:]
    v = [0.0] * (width - len(v)) + v
    out = []
    for x in v:
        idx = min(len(chars) - 1,
                  int(max(0.0, min(100.0, x)) / 100 * (len(chars) - 1) + 0.5))
        r, g, b = heat(x)
        out.append(rgb(r, g, b, chars[idx]))
    return "".join(out)


def dur_sec(t):
    t = (t or "").strip()
    if t in ("", "N/A", "UNLIMITED", "NOT_SET", "INVALID"):
        return None
    days = 0
    if "-" in t:
        d, _, t = t.partition("-")
        days = int(d) if d.isdigit() else 0
    parts = [int(x) for x in t.split(":") if x.isdigit()]
    if len(parts) == 3:
        h, m, sec = parts
    elif len(parts) == 2:
        h, m, sec = 0, parts[0], parts[1]
    elif len(parts) == 1:
        h, m, sec = 0, 0, parts[0]
    else:
        return None
    return ((days * 24 + h) * 60 + m) * 60 + sec


def fmt_dur(t):
    """Slurm 的 D-HH:MM:SS / HH:MM:SS / MM:SS 轉成好讀的形式。"""
    t = (t or "").strip()
    if t in ("", "N/A", "NOT_SET", "INVALID", "UNLIMITED"):
        return "-" if t != "UNLIMITED" else "inf"
    days = 0
    if "-" in t:
        d, _, t = t.partition("-")
        days = int(d) if d.isdigit() else 0
    parts = [int(x) for x in t.split(":") if x.isdigit()]
    if len(parts) == 3:
        h, m, sec = parts
    elif len(parts) == 2:
        h, m, sec = 0, parts[0], parts[1]
    elif len(parts) == 1:
        h, m, sec = 0, 0, parts[0]
    else:
        return t
    h += days * 24
    if h >= 24:
        return f"{h // 24}d{h % 24:02d}h"
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{sec:02d}s"
    return f"{sec}s"


