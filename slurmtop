def _prom_label(v):
    return str(v).replace("\\", "\\\\").replace("\n", "\\n").replace('"', '\\"')


def prometheus(m):
    """model() -> Prometheus 文字格式，給 Grafana 之類的工具抓。"""
    lines = []

    def metric(name, help_, rows, kind="gauge"):
        lines.append("# HELP slurmtop_%s %s" % (name, help_))
        lines.append("# TYPE slurmtop_%s %s" % (name, kind))
        for labels, v in rows:
            if v is None:
                continue
            lab = ",".join('%s="%s"' % (k, _prom_label(x)) for k, x in labels.items())
            lines.append("slurmtop_%s{%s} %s" % (name, lab, repr(float(v)) if isinstance(v, float) else v))

    ns = m["nodes"]
    gpus = [({"node": n["name"], "gpu": g["index"], "vendor": g["vendor"]}, g)
            for n in ns if n["up"] for g in n["gpus"]]
    metric("node_up", "1 if the node answered (possibly stale), 0 if unreachable",
           [({"node": n["name"]}, int(n["up"])) for n in ns])
    metric("node_stale_seconds", "age of the reading shown for a node that missed the deadline",
           [({"node": n["name"]}, n["stale_s"]) for n in ns])
    up = [n for n in ns if n["up"]]
    metric("cpu_utilization_percent", "node CPU utilisation", [({"node": n["name"]}, n["cpu_pct"]) for n in up])
    metric("memory_used_bytes", "node memory in use", [({"node": n["name"]}, n["mem_used_mib"] * 1048576) for n in up])
    metric("memory_total_bytes", "node memory", [({"node": n["name"]}, n["mem_total_mib"] * 1048576) for n in up])
    metric("load1", "1-minute load average", [({"node": n["name"]}, n["load"][0]) for n in up])
    metric("disk_used_bytes", "root filesystem in use", [({"node": n["name"]}, (n["disk"] or {}).get("used")) for n in up])
    metric("disk_total_bytes", "root filesystem size", [({"node": n["name"]}, (n["disk"] or {}).get("total")) for n in up])
    metric("network_receive_bytes_per_second", "receive rate over physical interfaces",
           [({"node": n["name"]}, (n["net"] or {}).get("rx")) for n in up])
    metric("network_transmit_bytes_per_second", "transmit rate over physical interfaces",
           [({"node": n["name"]}, (n["net"] or {}).get("tx")) for n in up])
    metric("gpu_utilization_percent", "GPU utilisation", [(l, g["util"]) for l, g in gpus])
    metric("gpu_memory_used_bytes", "GPU memory in use",
           [(l, None if g["mem_used_mib"] is None else g["mem_used_mib"] * 1048576) for l, g in gpus])
    metric("gpu_memory_total_bytes", "GPU memory",
           [(l, None if g["mem_total_mib"] is None else g["mem_total_mib"] * 1048576) for l, g in gpus])
    metric("gpu_temperature_celsius", "GPU temperature", [(l, g["temp_c"]) for l, g in gpus])
    metric("gpu_power_watts", "GPU power draw", [(l, g["power_w"]) for l, g in gpus])
    metric("gpu_idle_held", "1 if a job holds the GPU but has left it idle",
           [(l, int(g["idle_held"])) for l, g in gpus])
    metric("gpu_owner_info", "the job and user holding a GPU (value is always 1)",
           [(dict(l, job=g["job"], user=g["user"] or ""), 1) for l, g in gpus if g["job"]])
    states = {}
    for j in m["queue"]:
        states[j.get("state", "")] = states.get(j.get("state", ""), 0) + 1
    metric("jobs", "jobs in the Slurm queue by state", [({"state": k}, v) for k, v in sorted(states.items())])
    return "\n".join(lines) + "\n"


